(include "../theories/theory.eo")

; Rare rules in Rare 2.0 syntax.

;;;;;;;;;;;;;;;;;
; Arith
;;;;;;;;;;;;;;;;;

; Comment from original file:
; TODO this rule and the next three are not necessarily things we want to have as valid
(declare-rule arith-div-total-zero-real ((@T0 Type) (t1 @T0))
  :args (t1)
  :conclusion-explicit (@cl (= (/ t1 0/1) 0/1))
)
(declare-rule arith-div-total-zero-int ((@T0 Type) (t1 @T0))
  :args (t1)
  :conclusion-explicit (@cl (= (/ t1 0) 0/1))
)
(declare-rule arith-int-div-total-zero ((t1 Int))
  :args (t1)
  :conclusion-explicit (@cl (= (div t1 0) 0))
)
(declare-rule arith-int-mod-total-zero ((t1 Int))
  :args (t1)
  :conclusion-explicit (@cl (= (mod t1 0) t1))
)

;; Comment from original file: TODO artifact of cvc5's new totalized operators
(declare-rule arith-int-div-total ((t1 Int) (s1 Int))
  :premises ((= (= s1 0) false))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (div t1 s1) (div t1 s1)))
)
(declare-rule arith-int-div-total-one ((t1 Int))
  :args (t1)
  :conclusion-explicit (@cl (= (div t1 1) t1))
)

(declare-rule arith-int-div-total-neg ((t1 Int) (s1 Int))
  :premises ((= (< s1 0) true))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (div t1 s1) (- (div t1 (- s1)))))
)
(declare-rule arith-int-mod-total ((t1 Int) (s1 Int))
  :premises ((= (= s1 0) false))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (mod t1 s1) (mod t1 s1)))
)
(declare-rule arith-int-mod-total-one ((t1 Int))
  :args (t1)
  :conclusion-explicit (@cl (= (mod t1 1) 0))
)
(declare-rule arith-int-mod-total-neg ((t1 Int) (s1 Int))
  :premises ((= (< s1 0) true))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (mod t1 s1) (mod t1 (- s1))))
)
(declare-rule arith-elim-gt ((@T0 Type) (@T1 Type) (t1 @T0) (s1 @T1))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (> t1 s1) (not (>= s1 t1))))
)
(declare-rule arith-elim-lt ((@T0 Type) (@T1 Type) (t1 @T0) (s1 @T1))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (< t1 s1) (not (>= t1 s1))))
)
(declare-rule arith-elim-int-gt ((t1 Int) (s1 Int))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (> t1 s1) (>= t1 (+ s1 1))))
)
(declare-rule arith-elim-int-lt ((t1 Int) (s1 Int))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (< t1 s1) (>= s1 (+ t1 1))))
)
(declare-rule arith-elim-leq ((@T0 Type) (@T1 Type) (t1 @T0) (s1 @T1))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (<= t1 s1) (>= s1 t1)))
)
(declare-rule arith-leq-norm ((t1 Int) (s1 Int))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (<= t1 s1) (not (>= t1 (+ s1 1)))))
)
(declare-rule arith-geq-tighten ((t1 Int) (s1 Int))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (not (>= t1 s1)) (>= s1 (+ t1 1))))
)
(declare-rule arith-geq-norm1-int ((t1 Int) (s1 Int))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (>= t1 s1) (>= (- t1 s1) 0)))
)
(declare-rule arith-geq-norm1-real ((t1 Real) (s1 Real))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (>= t1 s1) (>= (- t1 s1) 0/1)))
)
(declare-rule arith-eq-elim-real ((t1 Real) (s1 Real))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (= t1 s1) (and (>= t1 s1) (<= t1 s1))))
)
(declare-rule arith-eq-elim-int ((t1 Int) (s1 Int))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (= t1 s1) (and (>= t1 s1) (<= t1 s1))))
)
(declare-rule arith-to-int-elim-to-real ((@T0 Type) (x1 @T0))
  :args (x1)
  :conclusion-explicit (@cl (= (to_int (to_real x1)) (to_int x1)))
)
(declare-rule arith-div-elim-to-real1 ((@T0 Type) (@T1 Type) (x1 @T0) (y1 @T1))
  :args (x1 y1)
  :conclusion-explicit (@cl (= (/ (to_real x1) y1) (/ x1 y1)))
)
(declare-rule arith-div-elim-to-real2 ((@T0 Type) (@T1 Type) (x1 @T0) (y1 @T1))
  :args (x1 y1)
  :conclusion-explicit (@cl (= (/ x1 (to_real y1)) (/ x1 y1)))
)
(declare-rule arith-mod-over-mod ((c1 Int) (ts1 Int :list) (r1 Int) (ss1 Int :list))
  :premises ((= (= c1 0) false))
  :args (c1 ts1 r1 ss1)
  :conclusion (@cl (= (mod (+ ts1 (mod r1 c1) ss1) c1) 
                      (mod (eo::list_singleton_elim + (+ ts1 r1 ss1)) c1)))
)
(declare-rule arith-int-eq-conflict ((t1 Int) (c1 Real))
  :premises ((= (= (to_real (to_int c1)) c1) false))
  :args (t1 c1)
  :conclusion-explicit (@cl (= (= (to_real t1) c1) false))
)
(declare-rule arith-int-geq-tighten ((t1 Int) (c1 Real) (cc1 Int))
  :premises ((= (= (to_real (to_int c1)) c1) false) (= cc1 (+ (to_int c1) 1)))
  :args (t1 c1 cc1)
  :conclusion-explicit (@cl (= (>= (to_real t1) c1) (>= t1 cc1)))
)
(declare-rule arith-abs-eq ((@T0 Type) (@T1 Type) (x1 @T0) (y1 @T1))
  :args (x1 y1)
  :conclusion-explicit (@cl (= (= (abs x1) (abs y1)) (or (= x1 y1) (= x1 (- y1)))))
)
(declare-rule arith-abs-int-gt ((x1 Int) (y1 Int))
  :args (x1 y1)
  :conclusion-explicit (@cl (= (> (abs x1) (abs y1)) (eo::define ((_let_1 (- y1))) (eo::define ((_let_2 (- x1))) (eo::define ((_let_3 (>= y1 0))) (ite (>= x1 0) (ite _let_3 (> x1 y1) (> x1 _let_1)) (ite _let_3 (> _let_2 y1) (> _let_2 _let_1))))))))
)
(declare-rule arith-abs-real-gt ((x1 Real) (y1 Real))
  :args (x1 y1)
  :conclusion-explicit (@cl (= (> (abs x1) (abs y1)) (eo::define ((_let_1 (- y1))) (eo::define ((_let_2 (- x1))) (eo::define ((_let_3 (>= y1 0/1))) (ite (>= x1 0/1) (ite _let_3 (> x1 y1) (> x1 _let_1)) (ite _let_3 (> _let_2 y1) (> _let_2 _let_1))))))))
)
(declare-rule arith-geq-ite-lift ((@T0 Type) (@T1 Type) (@T2 Type) (C1 Bool) (t1 @T0) (s1 @T1) (r1 @T2))
  :args (C1 t1 s1 r1)
  :conclusion-explicit (@cl (= (>= (ite C1 t1 s1) r1) (ite C1 (>= t1 r1) (>= s1 r1))))
)
(declare-rule arith-leq-ite-lift ((@T0 Type) (@T1 Type) (@T2 Type) (C1 Bool) (t1 @T0) (s1 @T1) (r1 @T2))
  :args (C1 t1 s1 r1)
  :conclusion-explicit (@cl (= (<= (ite C1 t1 s1) r1) (ite C1 (<= t1 r1) (<= s1 r1))))
)
(declare-rule arith-min-lt1 ((@T0 Type) (@T1 Type) (t1 @T0) (s1 @T1))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (<= (ite (< t1 s1) t1 s1) t1) true))
)
(declare-rule arith-min-lt2 ((@T0 Type) (@T1 Type) (t1 @T0) (s1 @T1))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (<= (ite (< t1 s1) t1 s1) s1) true))
)
(declare-rule arith-max-geq1 ((@T0 Type) (@T1 Type) (t1 @T0) (s1 @T1))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (>= (ite (>= t1 s1) t1 s1) t1) true))
)
(declare-rule arith-max-geq2 ((@T0 Type) (@T1 Type) (t1 @T0) (s1 @T1))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (>= (ite (>= t1 s1) t1 s1) s1) true))
)

;;;;;;;;;;;;;;;;
; Prop. logic
;;;;;;;;;;;;;;;;

(declare-rule bool-double-not-elim ((t1 Bool))
  :args (t1)
  :conclusion-explicit (@cl (= (not (not t1)) t1))
)
(declare-rule bool-not-true ((t1 Bool))
  :premises ((= t1 false))
  :args (t1)
  :conclusion-explicit (@cl (= (not t1) true))
)
(declare-rule bool-not-false ((t1 Bool))
  :premises ((= t1 true))
  :args (t1)
  :conclusion-explicit (@cl (= (not t1) false))
)
(declare-rule bool-eq-true ((t1 Bool))
  :args (t1)
  :conclusion-explicit (@cl (= (= t1 true) t1))
)
(declare-rule bool-eq-false ((t1 Bool))
  :args (t1)
  :conclusion-explicit (@cl (= (= t1 false) (not t1)))
)
(declare-rule bool-eq-nrefl ((x1 Bool))
  :args (x1)
  :conclusion-explicit (@cl (= (= x1 (not x1)) false))
)
(declare-rule bool-impl-false1 ((t1 Bool))
  :args (t1)
  :conclusion-explicit (@cl (= (=> t1 false) (not t1)))
)
(declare-rule bool-impl-false2 ((t1 Bool))
  :args (t1)
  :conclusion-explicit (@cl (= (=> false t1) true))
)
(declare-rule bool-impl-true1 ((t1 Bool))
  :args (t1)
  :conclusion-explicit (@cl (= (=> t1 true) true))
)
(declare-rule bool-impl-true2 ((t1 Bool))
  :args (t1)
  :conclusion-explicit (@cl (= (=> true t1) t1))
)
(declare-rule bool-impl-elim ((t1 Bool) (s1 Bool))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (=> t1 s1) (or (not t1) s1)))
)
(declare-rule bool-dual-impl-eq ((t1 Bool) (s1 Bool))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (and (=> t1 s1) (=> s1 t1)) (= t1 s1)))
)
(declare-rule bool-and-conf ((xs1 Bool :list) (w1 Bool) (ys1 Bool :list) (zs1 Bool :list))
  :args (xs1 w1 ys1 zs1)
  :conclusion (@cl (= (and xs1 w1 ys1 (not w1) zs1) false))
)
(declare-rule bool-and-conf2 ((xs1 Bool :list) (w1 Bool) (ys1 Bool :list) (zs1 Bool :list))
  :args (xs1 w1 ys1 zs1)
  :conclusion (@cl (= (and xs1 (not w1) ys1 w1 zs1) false))
)
(declare-rule bool-or-taut ((xs1 Bool :list) (w1 Bool) (ys1 Bool :list) (zs1 Bool :list))
  :args (xs1 w1 ys1 zs1)
  :conclusion (@cl (= (or xs1 w1 ys1 (not w1) zs1) true))
)
(declare-rule bool-or-taut2 ((xs1 Bool :list) (w1 Bool) (ys1 Bool :list) (zs1 Bool :list))
  :args (xs1 w1 ys1 zs1)
  :conclusion (@cl (= (or xs1 (not w1) ys1 w1 zs1) true))
)
(declare-rule bool-or-de-morgan ((x1 Bool) (y1 Bool) (zs1 Bool :list))
  :args (x1 y1 zs1)
  :conclusion-explicit (@cl (= (not (or x1 y1 zs1)) (and (not x1) (not (or y1 zs1)))))
)
(declare-rule bool-implies-de-morgan ((x1 Bool) (y1 Bool))
  :args (x1 y1)
  :conclusion-explicit (@cl (= (not (=> x1 y1)) (and x1 (not y1))))
)
(declare-rule bool-and-de-morgan ((x1 Bool) (y1 Bool) (zs1 Bool :list))
  :args (x1 y1 zs1)
  :conclusion-explicit (@cl (= (not (and x1 y1 zs1)) (or (not x1) (not (and y1 zs1)))))
)

(declare-rule bool-or-and-distrib ((y1 Bool) (y2 Bool) (ys1 Bool :list) (z1 Bool) (zs1 Bool :list))
  :args (y1 y2 ys1 z1 zs1)
  :conclusion-explicit (@cl (= (or (and y1 y2 ys1) z1 zs1) (and (or y1 z1 zs1) (or (and y2 ys1) z1 zs1))))
)
(declare-rule bool-implies-or-distrib ((y1 Bool) (y2 Bool) (ys1 Bool :list) (z1 Bool))
  :args (y1 y2 ys1 z1)
  :conclusion-explicit (@cl (= (=> (or y1 y2 ys1) z1) (and (=> y1 z1) (=> (or y2 ys1) z1))))
)
(declare-rule bool-xor-refl ((x1 Bool))
  :args (x1)
  :conclusion-explicit (@cl (= (xor x1 x1) false))
)
(declare-rule bool-xor-nrefl ((x1 Bool))
  :args (x1)
  :conclusion-explicit (@cl (= (xor x1 (not x1)) true))
)
(declare-rule bool-xor-false ((x1 Bool))
  :args (x1)
  :conclusion-explicit (@cl (= (xor x1 false) x1))
)
(declare-rule bool-xor-true ((x1 Bool))
  :args (x1)
  :conclusion-explicit (@cl (= (xor x1 true) (not x1)))
)
(declare-rule bool-xor-comm ((x1 Bool) (y1 Bool))
  :args (x1 y1)
  :conclusion-explicit (@cl (= (xor x1 y1) (xor y1 x1)))
)
(declare-rule bool-xor-elim ((x1 Bool) (y1 Bool))
  :args (x1 y1)
  :conclusion-explicit (@cl (= (xor x1 y1) (= (not x1) y1)))
)
(declare-rule bool-not-xor-elim ((x1 Bool) (y1 Bool))
  :args (x1 y1)
  :conclusion-explicit (@cl (= (not (xor x1 y1)) (= x1 y1)))
)
(declare-rule bool-not-eq-elim1 ((x1 Bool) (y1 Bool))
  :args (x1 y1)
  :conclusion-explicit (@cl (= (not (= x1 y1)) (= (not x1) y1)))
)
(declare-rule bool-not-eq-elim2 ((x1 Bool) (y1 Bool))
  :args (x1 y1)
  :conclusion-explicit (@cl (= (not (= x1 y1)) (= x1 (not y1))))
)

;;;;;;;;;;;;;;;;;;;;
; Ite
;;;;;;;;;;;;;;;;;;;;

(declare-rule ite-neg-branch ((c1 Bool) (x1 Bool) (y1 Bool))
  :premises ((= (not y1) x1))
  :args (c1 x1 y1)
  :conclusion-explicit (@cl (= (ite c1 x1 y1) (= c1 x1)))
)
(declare-rule ite-then-true ((c1 Bool) (x1 Bool))
  :args (c1 x1)
  :conclusion-explicit (@cl (= (ite c1 true x1) (or c1 x1)))
)
(declare-rule ite-else-false ((c1 Bool) (x1 Bool))
  :args (c1 x1)
  :conclusion-explicit (@cl (= (ite c1 x1 false) (and c1 x1)))
)
(declare-rule ite-then-false ((c1 Bool) (x1 Bool))
  :args (c1 x1)
  :conclusion-explicit (@cl (= (ite c1 false x1) (and (not c1) x1)))
)
(declare-rule ite-else-true ((c1 Bool) (x1 Bool))
  :args (c1 x1)
  :conclusion-explicit (@cl (= (ite c1 x1 true) (or (not c1) x1)))
)
(declare-rule ite-then-lookahead-self ((c1 Bool) (x1 Bool))
  :args (c1 x1)
  :conclusion-explicit (@cl (= (ite c1 c1 x1) (ite c1 true x1)))
)
(declare-rule ite-else-lookahead-self ((c1 Bool) (x1 Bool))
  :args (c1 x1)
  :conclusion-explicit (@cl (= (ite c1 x1 c1) (ite c1 x1 false)))
)
(declare-rule ite-then-lookahead-not-self ((c1 Bool) (x1 Bool))
  :args (c1 x1)
  :conclusion-explicit (@cl (= (ite c1 (not c1) x1) (ite c1 false x1)))
)
(declare-rule ite-else-lookahead-not-self ((c1 Bool) (x1 Bool))
  :args (c1 x1)
  :conclusion-explicit (@cl (= (ite c1 x1 (not c1)) (ite c1 x1 true)))
)
(declare-rule ite-expand ((c1 Bool) (x1 Bool) (y1 Bool))
  :args (c1 x1 y1)
  :conclusion-explicit (@cl (= (ite c1 x1 y1) (and (or (not c1) x1) (or c1 y1))))
)
(declare-rule bool-not-ite-elim ((c1 Bool) (x1 Bool) (y1 Bool))
  :args (c1 x1 y1)
  :conclusion-explicit (@cl (= (not (ite c1 x1 y1)) (ite c1 (not x1) (not y1))))
)
(declare-rule ite-true-cond ((@T0 Type) (@T1 Type) (x1 @T0) (y1 @T1))
  :args (x1 y1)
  :conclusion-explicit (@cl (= (ite true x1 y1) x1))
)
(declare-rule ite-false-cond ((@T0 Type) (@T1 Type) (x1 @T0) (y1 @T1))
  :args (x1 y1)
  :conclusion-explicit (@cl (= (ite false x1 y1) y1))
)
(declare-rule ite-not-cond ((@T0 Type) (@T1 Type) (c1 Bool) (x1 @T0) (y1 @T1))
  :args (c1 x1 y1)
  :conclusion-explicit (@cl (= (ite (not c1) x1 y1) (ite c1 y1 x1)))
)
(declare-rule ite-eq-branch ((@T0 Type) (c1 Bool) (x1 @T0))
  :args (c1 x1)
  :conclusion-explicit (@cl (= (ite c1 x1 x1) x1))
)
(declare-rule ite-then-lookahead ((@T0 Type) (@T1 Type) (@T2 Type) (c1 Bool) (x1 @T0) (y1 @T1) (z1 @T2))
  :args (c1 x1 y1 z1)
  :conclusion-explicit (@cl (= (ite c1 (ite c1 x1 y1) z1) (ite c1 x1 z1)))
)
(declare-rule ite-else-lookahead ((@T0 Type) (@T1 Type) (@T2 Type) (c1 Bool) (x1 @T0) (y1 @T1) (z1 @T2))
  :args (c1 x1 y1 z1)
  :conclusion-explicit (@cl (= (ite c1 x1 (ite c1 y1 z1)) (ite c1 x1 z1)))
)
(declare-rule ite-then-neg-lookahead ((@T0 Type) (@T1 Type) (@T2 Type) (c1 Bool) (x1 @T0) (y1 @T1) (z1 @T2))
  :args (c1 x1 y1 z1)
  :conclusion-explicit (@cl (= (ite c1 (ite (not c1) x1 y1) z1) (ite c1 y1 z1)))
)
(declare-rule ite-else-neg-lookahead ((@T0 Type) (@T1 Type) (@T2 Type) (c1 Bool) (x1 @T0) (y1 @T1) (z1 @T2))
  :args (c1 x1 y1 z1)
  :conclusion-explicit (@cl (= (ite c1 x1 (ite (not c1) y1 z1)) (ite c1 x1 y1)))
)

;;;;;;;;;;;;;;;;;;
; Eq
;;;;;;;;;;;;;;;;;;

(declare-rule eq-refl ((@T0 Type) (t1 @T0))
  :args (t1)
  :conclusion-explicit (@cl (= (= t1 t1) true))
)
(declare-rule eq-symm ((@T0 Type) (@T1 Type) (t1 @T0) (s1 @T1))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (= t1 s1) (= s1 t1)))
)
(declare-rule eq-cond-deq ((@T0 Type) (@T1 Type) (@T2 Type) (t1 @T0) (s1 @T1) (r1 @T2))
  :premises ((= (= s1 r1) false))
  :args (t1 s1 r1)
  :conclusion-explicit (@cl (= (= (= t1 s1) (= t1 r1)) (and (not (= t1 s1)) (not (= t1 r1)))))
)
(declare-rule eq-ite-lift ((@T0 Type) (@T1 Type) (@T2 Type) (C1 Bool) (t1 @T0) (s1 @T1) (r1 @T2))
  :args (C1 t1 s1 r1)
  :conclusion-explicit (@cl (= (= (ite C1 t1 s1) r1) (ite C1 (= t1 r1) (= s1 r1))))
)
(declare-rule distinct-binary-elim ((@T0 Type) (@T1 Type) (t1 @T0) (s1 @T1))
  :args (t1 s1)
  :conclusion-explicit (@cl (= (distinct t1 s1) (not (= t1 s1))))
)

(declare-rule arith-mod-over-mod-1 ((c Int) (r Int))
  :premises ((= (= c 0) false))
  :args (c r)  
  :conclusion-explicit (@cl (= (mod (mod r c) c) (mod r c))))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; used by Alethe's translation
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(declare-rule ite-eq ((@T0 Type) (@T1 Type) (C Bool) (t1 @T0) (t2 @T1))
  :args (C t1 t2)
  :conclusion-explicit (@cl (= (ite C (= (ite C t1 t2) t1) (= (ite C t1 t2) t2)) true)))

(declare-rule or-not-refl ((@T0 Type) (t @T0) (xs Bool :list))
   :args (t xs)
   :conclusion-explicit (@cl (= (or (not (= t t)) xs) (or xs))))

(declare-rule bool-not-eq-false ((t Bool))
   :args (t)
   :conclusion-explicit (@cl (= (not (= t t)) false)))

(declare-rule distinct-false ((@T0 Type) (t @T0) (xs @T0 :list) (ys @T0 :list) (zs @T0 :list))
   :args (t xs ys zs)
   :conclusion-explicit (@cl (= (distinct xs t ys t zs) false)))

(declare-rule mod-elim ((a Int) (b Int))
  :args (a b)
  :conclusion-explicit (@cl (= (mod a b) (- a (* b (div a b))))))

(declare-rule is_int-elim ((x Real))
  :args (x)
  :conclusion-explicit (@cl (= (is_int x) (= x (to_real (to_int x))))))

(declare-rule abs-elim-int ((t Int))
   :args (t)
   :conclusion-explicit (@cl (= (abs t) (ite (< t 0) (- t) t))))

(declare-rule abs-elim-real ((t Real))
   :args (t)
   :conclusion-explicit (@cl (= (abs t) (ite (< t 0/1) (- t) t))))

(declare-rule mult-tangent-lower ((@T0 Type) (x @T0) (y @T0) (a @T0) (b @T0))
   :args (x y a b)
   :conclusion-explicit (@cl (= (<= (* x y) (- (+ (* b x) (* a y)) (* a b))) (or (and (<= x a) (>= y b)) (and (>= x a) (<= y b))))))

(declare-rule mult-tangent-upper ((@T0 Type) (x @T0) (y @T0) (a @T0) (b @T0))
   :args (x y a b)
   :conclusion-explicit (@cl (= (>= (* x y) (- (+ (* b x) (* a y)) (* a b))) (or (and (<= x a) (<= y b)) (and (>= x a) (>= y b))))))
