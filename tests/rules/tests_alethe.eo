;------------------------------------------
; resolution
;------------------------------------------

(assume premise_resolution_1_1 (@cl (not p) r))
(assume premise_resolution_1_2 (@cl p (not q)))
(assume premise_resolution_1_3 (@cl q r))

(step $test_resolution_1
      (@cl r (not q))
      :rule resolution
      :premises (premise_resolution_1_1 premise_resolution_1_2 premise_resolution_1_3)
      :args ((@varlist p true)))


(declare-const p Bool)
(declare-const q Bool)
(declare-const r Bool)
(declare-const s Bool)

(assume premise_resolution_2_1 (@cl (not p) (not q) (not r) s))
(assume premise_resolution_2_2 (@cl (not (and p q)) q))
(assume premise_resolution_2_3 (@cl (not (and p q)) p))
(assume premise_resolution_2_4 (@cl (and s r) (and p q)))
(assume premise_resolution_2_5 (@cl (not (and s r)) s))

(step $test_resolution_2 
      (@cl (not r) s)
      :rule resolution 
      :premises (premise_resolution_2_1 premise_resolution_2_2 premise_resolution_2_3 
                 premise_resolution_2_4 premise_resolution_2_5)
      :args ((@varlist q false 
                       p false
                       (and p q) false
                       (and s r) true)))

; Example from VeriT certificate.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)

(assume premise_resolution_3_1 (@cl (= c (= b a))))
(assume premise_resolution_3_2 (@cl (not (= c (= b a)))
                       (= c (= a b))))
(step $test_resolution_3
      (@cl (= c (= a b)))
      :rule resolution :premises (premise_resolution_3_1 premise_resolution_3_2) 
      :args ((@varlist (= c (= b a)) true)))

; Example from VeriT certificate.
(declare-const a Bool)
(declare-const b Bool)

(assume premise_resolution_4_1 (@cl (not (not (not a))) a))
(assume premise_resolution_4_2 (@cl (not (not a)) (not (not b))))
(step $test_resolution_4 
      (@cl a (not (not b))) 
      :rule resolution 
      :premises ( premise_resolution_4_1 premise_resolution_4_2 ) 
      :args ( (@varlist (not (not a)) false) ))

; Example from VeriT certificate.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(assume premise_resolution_5_1 (@cl (not (not (and (not (= a b)) (= a c))))))
(assume premise_resolution_5_2 (@cl (not (not (not (and (not (= a b)) (= a c))))) 
                       (not (not (and (not (= b a)) (= a c))))))
(step $test_resolution_5 
      (@cl (not (not (and (not (= b a)) (= a c)))))
      :rule resolution
      :premises ( premise_resolution_5_1 premise_resolution_5_2 ) 
      :args ( (@varlist (not (not (and (not (= a b)) (= a c)))) true) ))

