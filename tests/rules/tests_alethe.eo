(include "../../signature/rules/alethe.eo")
(include "../unit_test_services.eo")


; Unit tests for rules in `alethe.eo`.

;------------------------------------------
; $negative_normal_form
;------------------------------------------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)

; Atomic props.
(step $test_$negative_normal_form_1 true 
      :rule $assert_eq 
      :args (($negative_normal_form (not (not a)) true)

             a))

(step $test_$negative_normal_form_2 true 
      :rule $assert_eq 
      :args (($negative_normal_form (not a) true)

             (not a)))

; Non-atomic
; and
(step $test_$negative_normal_form_3 true 
      :rule $assert_eq 
      :args (($negative_normal_form (not ($f_list_cons and a b)) true)

             ($f_list_cons or (not a) (not b))))

(step $test_$negative_normal_form_4 true 
      :rule $assert_eq 
      :args (($negative_normal_form (not ($f_list_cons and a b)) false)

             ($f_list_cons and a b)))

; or
(step $test_$negative_normal_form_5 true 
      :rule $assert_eq 
      :args (($negative_normal_form (not ($f_list_cons or a b)) true)

             ($f_list_cons and (not a) (not b))))

(step $test_$negative_normal_form_6 true 
      :rule $assert_eq 
      :args (($negative_normal_form (not ($f_list_cons or a b)) false)

             ($f_list_cons or a b)))

; =>
(step $test_$negative_normal_form_7 true 
      :rule $assert_eq 
      :args (($negative_normal_form (not (=> a b)) true)

             ($f_list_cons and a (not b))))

(step $test_$negative_normal_form_8 true 
      :rule $assert_eq 
      :args (($negative_normal_form (=> a b) true)

             ($f_list_cons or (not a) b)))

(step $test_$negative_normal_form_9 true 
      :rule $assert_eq 
      :args (($negative_normal_form (not (=> a b)) false)

             ($f_list_cons or (not a) b)))

; ite
(step $test_$negative_normal_form_10 true 
      :rule $assert_eq 
      :args (($negative_normal_form (ite a b c) true)

             ($f_list_cons and 
                           ($f_list_cons or (not a) b)
                           ($f_list_cons or a c))))

(step $test_$negative_normal_form_11 true 
      :rule $assert_eq 
      :args (($negative_normal_form (ite a b c) false)

             ($f_list_cons or
                           ($f_list_cons and a (not b))
                           ($f_list_cons and (not a) (not c)))))

; forall
(step $test_$negative_normal_form_12 true 
      :rule $assert_eq 
      :args (($negative_normal_form (forall (@varlist (eo::var "x" Int)) a) true)

             (forall (@varlist (eo::var "x" Int)) a)))

(step $test_$negative_normal_form_13 true 
      :rule $assert_eq 
      :args (($negative_normal_form (forall (@varlist (eo::var "x" Int)) a) false)

             (exists (@varlist (eo::var "x" Int)) (not a))))

; exists
(step $test_$negative_normal_form_14 true 
      :rule $assert_eq 
      :args (($negative_normal_form (exists (@varlist (eo::var "x" Int)) a) true)

             (exists (@varlist (eo::var "x" Int)) a)))

(step $test_$negative_normal_form_15 true 
      :rule $assert_eq 
      :args (($negative_normal_form (exists (@varlist (eo::var "x" Int)) a) false)

             (forall (@varlist (eo::var "x" Int)) (not a))))

; Misc.
(step $test_$negative_normal_form_16 true 
      :rule $assert_eq 
      :args (($negative_normal_form a true)

             a))

(step $test_$negative_normal_form_17 true 
      :rule $assert_eq 
      :args (($negative_normal_form a false)

             (not a)))


