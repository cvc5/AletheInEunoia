                         (= (@var ( ( y Bool ) ) y) true)
                         (@ctx @varlist.nil true)))

              (forall ((x Bool) (y Bool)) (=> (= true
                                                (@var ( ( y Bool ) ) y)) 
                                             (@var ( ( y Bool ) ) y)))

              (forall ((x Bool)) (=> (= true true) true)))

             true))

