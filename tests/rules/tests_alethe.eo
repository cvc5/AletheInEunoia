              (@ctx @varlist.nil true)

              (@ctx ((x Bool) (y Bool) (z Bool) (w Bool)) 
                    (and (= (@var ( ( x Bool ) ) x) (@var ( ( x Bool ) ) x))
                         (= (@var ( ( z Bool ) ) z) (@var ( ( x Bool ) ) x))
                         (= (@var ( ( y Bool ) ) y) true)
                         (= (@var ( ( w Bool ) ) w) false)
                         (@ctx @varlist.nil true)))

              (forall ((w Bool) (x Bool) (y Bool) (z Bool)) (=> (and (= true
                                                                       (@var ( ( y Bool ) ) y))
                                                                    (= (@var ( ( z Bool ) ) z)
