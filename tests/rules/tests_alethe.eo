(step $test_$check_onepoint_1 true 
      :rule $assert_eq 
      :args (($check_onepoint
              (@ctx @varlist.nil true)

              (@ctx ((x Bool) (y Bool)) 
                    (and (= (@var ( ( x Bool ) ) x) (@var ( ( x Bool ) ) x))
                         (= (@var ( ( y Bool ) ) y) (@var ( ( x Bool ) ) x))
                         (@ctx @varlist.nil true)))

              (forall ((x Bool) (y Bool)) (=> (= (@var ( ( x Bool ) ) x)
                                                (@var ( ( y Bool ) ) y)) 
                                             (@var ( ( x Bool ) ) x)))

              (forall ((x Bool)) (=> (= (@var ( ( x Bool ) ) x) 
                                       (@var ( ( x Bool ) ) x)) 
                                    (@var ( ( x Bool ) ) x))))

             true))

(step $test_$check_onepoint_2 true 
