(declare-const o Bool)
(declare-const r Bool)

(step $test_$check_resolution_13 true 
      :rule $assert_eq 
      :args (($check_resolution
              (and (@cl (not a) (not b) (not p) (not q)
                        (not c) (not d) (not e) (not f)
                        (not g) (not h) (not i) (not j)
                        (not k) (not l) (not m) (not n)
                        (not o) (not r))
                   (@cl (not (and p q)) q)
                   (@cl (not (and p q)) p))
              (@varlist p false)
              (@cl (not a) (not b) (not q)
                   (not c) (not d) (not e) (not f)
                   (not g) (not h) (not i) (not j)
                   (not k) (not l) (not m) (not n)
                   (not o) (not r)
                   (not (and p q))))
             true))

(step $test_$check_resolution_13b true 
      :rule $assert_eq 
      :args (($check_resolution
              (and (@cl (not a) (not b) (not p) (not q)
                        (not c) (not d) (not e) (not f)
                        (not g) (not h) (not i) (not j)
                        (not k) (not l) (not m) (not n)
                        (not o) (not r))
                   (@cl (not (and p q)) q)
                   (@cl (not (and p q)) p))
              (@varlist q false)
              (@cl (not a) (not b) (not p)
                   (not c) (not d) (not e) (not f)
                   (not g) (not h) (not i) (not j)
                   (not k) (not l) (not m) (not n)
                   (not o) (not r)
                   (not (and p q))))
             true))

(step $test_$check_resolution_13c true 
