;----------
; onepoint
;----------

(define premise_context_onepoint_1 () (@ctx ((x Bool) (y Bool)) 
                                            (and (= (@var ( ( x Bool ) ) x) (@var ( ( x Bool ) ) x))
                                                 (= (@var ( ( y Bool ) ) y) (@var ( ( x Bool ) ) x))
                                                 (@ctx @varlist.nil true))))
(assume-push premise_context premise_context_onepoint_1)
(step premise_onepoint_1 (@cl (= (=> (= (@var ( ( x Bool ) ) x)
                                       (@var ( ( y Bool ) ) y)) 
                                    (@var ( ( x Bool ) ) x))
                                 (=> (= (@var ( ( x Bool ) ) x) 
                                       (@var ( ( x Bool ) ) x)) 
                                    (@var ( ( x Bool ) ) x)))) :rule hole)
(define conclusion_context_onepoint_1 () (@ctx @varlist.nil true))
(step-pop $test_onepoint_1
          (@cl (= (forall ((x Bool) (y Bool)) (=> (= (@var ( ( x Bool ) ) x)
                                                    (@var ( ( y Bool ) ) y)) 
                                                 (@var ( ( x Bool ) ) x)))

                  (forall ((x Bool)) (=> (= (@var ( ( x Bool ) ) x) 
                                           (@var ( ( x Bool ) ) x)) 
                                        (@var ( ( x Bool ) ) x)))))
          :rule onepoint
          :premises (premise_onepoint_1)
          :args (conclusion_context_onepoint_1))


; Variable mapped to an arbitrary term
(define premise_context_onepoint_2 () (@ctx ((x Bool) (y Bool)) 
                                            (and (= (@var ( ( x Bool ) ) x) (@var ( ( x Bool ) ) x))
                                                 (= (@var ( ( y Bool ) ) y) true)
                                                 (@ctx @varlist.nil true))))
(assume-push premise_context premise_context_onepoint_2)
(step premise_onepoint_2 (@cl (= (=> (= true
                                       (@var ( ( y Bool ) ) y))
                                    (@var ( ( x Bool ) ) x))
                                 (=> (= true
                                       true) 
                                    (@var ( ( x Bool ) ) x)))) :rule hole)
(define conclusion_context_onepoint_2 () (@ctx @varlist.nil true))
(step-pop $test_onepoint_2
          (@cl (= (forall ((x Bool) (y Bool)) (=> (= true
                                                    (@var ( ( y Bool ) ) y)) 
                                                 (@var ( ( x Bool ) ) x)))

                  (forall ((x Bool)) (=> (= true
                                           true) 
                                        (@var ( ( x Bool ) ) x)))))
          :rule onepoint
          :premises (premise_onepoint_2)
          :args (conclusion_context_onepoint_2))

; More quantified variables
(define premise_context_onepoint_3 () (@ctx ((x Bool) (y Bool) (z Bool)) 
                                            (and (= (@var ( ( x Bool ) ) x) (@var ( ( x Bool ) ) x))
                                                 (= (@var ( ( z Bool ) ) z) (@var ( ( x Bool ) ) x))
                                                 (= (@var ( ( y Bool ) ) y) true)
                                                 (@ctx @varlist.nil true))))
(assume-push premise_context premise_context_onepoint_3)
(step premise_onepoint_3 (@cl (= (=> (and (= true (@var ( ( y Bool ) ) y))
                                         (= (@var ( ( z Bool ) ) z) (@var ( ( x Bool ) ) x)))
                                    (@var ( ( z Bool ) ) z))
                                 (=> (and (= true true)
                                         (= (@var ( ( x Bool ) ) x) (@var ( ( x Bool ) ) x)))
                                    (@var ( ( x Bool ) ) x)))) :rule hole)
(define conclusion_context_onepoint_3 () (@ctx @varlist.nil true))
(step-pop $test_onepoint_3
          (@cl (= (forall ((x Bool) (y Bool) (z Bool)) (=> (and (= true (@var ( ( y Bool ) ) y))
                                                      (= (@var ( ( z Bool ) ) z) (@var ( ( x Bool ) ) x)))
                                                 (@var ( ( z Bool ) ) z)))

                  (forall ((x Bool)) (=> (and (= true true)
                                             (= (@var ( ( x Bool ) ) x) (@var ( ( x Bool ) ) x)))
                                        (@var ( ( x Bool ) ) x)))))
          :rule onepoint
          :premises (premise_onepoint_3)
          :args (conclusion_context_onepoint_3))
