                         (= (@var ( ( z Bool ) ) z) (@var ( ( x Bool ) ) x))
                         (= (@var ( ( y Bool ) ) y) true)
                         (@ctx @varlist.nil true)))

              (forall ((x Bool) (y Bool) (z Bool)) (=> (and (= true
                                                              (@var ( ( y Bool ) ) y))
