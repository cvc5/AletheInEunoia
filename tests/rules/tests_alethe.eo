      :rule $assert_eq 
      :args (($check_resolution
              (and (@cl (not p) (not q) (not r) s)
                   (@cl (not (and p q)) q)
                   (@cl (not (and p q)) p)
                   (@cl (and s r) (and p q))
                   (@cl (not (and s r)) s))
              (@varlist q false p false)
              (@cl (not r) s (not (and p q)) (not (and p q))))
             true))

