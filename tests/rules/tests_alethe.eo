;------------------------------------------
; $prenex_normal_form
;------------------------------------------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)

; Atomic props.
(step $test_$prenex_normal_form_1 true 
      :rule $assert_eq 
      :args (($prenex_normal_form a)

             a))

(step $test_$prenex_normal_form_2 true 
      :rule $assert_eq 
      :args (($prenex_normal_form (not a))

             (not a)))

; or
(step $test_$prenex_normal_form_3 true 
      :rule $assert_eq 
      :args (($prenex_normal_form (or a b))

             (or a b)))

(step $test_$prenex_normal_form_4 true 
      :rule $assert_eq 
      :args (($prenex_normal_form (or (forall (@varlist (eo::var "x" Int)) a) b))

             (forall (@varlist (eo::var "x" Int)) (or  a b))))

(step $test_$prenex_normal_form_5 true 
      :rule $assert_eq 
      :args (($prenex_normal_form (or b (forall (@varlist (eo::var "x" Int)) a)))

             (forall (@varlist (eo::var "x" Int)) (or b a))))

(step $test_$prenex_normal_form_6 true 
      :rule $assert_eq 
      :args (($prenex_normal_form ($f_list_cons or a
                                                ($f_list_cons or 
                                                              b 
                                                              (forall (@varlist (eo::var "x" Int)) c))))

             (forall (@varlist (eo::var "x" Int)) 
                     ($f_list_cons or a ($f_list_cons or b c)))))

; and
(step $test_$prenex_normal_form_7 true 
      :rule $assert_eq 
      :args (($prenex_normal_form (and a b))

             (and a b)))

(step $test_$prenex_normal_form_8 true 
      :rule $assert_eq 
      :args (($prenex_normal_form (and (forall (@varlist (eo::var "x" Int)) a) b))

             (forall (@varlist (eo::var "x" Int)) (and  a b))))

(step $test_$prenex_normal_form_9 true 
      :rule $assert_eq 
      :args (($prenex_normal_form (and b (forall (@varlist (eo::var "x" Int)) a)))

             (forall (@varlist (eo::var "x" Int)) (and b a))))

(step $test_$prenex_normal_form_10 true 
      :rule $assert_eq 
      :args (($prenex_normal_form ($f_list_cons and a
                                                ($f_list_cons and 
                                                              b 
                                                              (forall (@varlist (eo::var "x" Int)) c))))

             (forall (@varlist (eo::var "x" Int)) 
                     ($f_list_cons and a ($f_list_cons and b c)))))

; forall
(step $test_$prenex_normal_form_11 true 
      :rule $assert_eq 
      :args (($prenex_normal_form (forall (@varlist (eo::var "x" Int))
                                          ($f_list_cons or 
                                                        a
                                                        (forall (@varlist (eo::var "y" Int)) b))))
             (forall (@varlist (eo::var "x" Int))
                     (forall (@varlist (eo::var "y" Int))
                                          ($f_list_cons or a b)))))

(step $test_$prenex_normal_form_12 true 
      :rule $assert_eq 
      :args (($prenex_normal_form 
              (forall (@varlist (eo::var "x" Int))
                      ($f_list_cons or 
                                    a
                                    ($f_list_cons and
                                                  b
                                                  (forall (@varlist (eo::var "y" Int)) c)))))
             (forall (@varlist (eo::var "x" Int))
                     (forall (@varlist (eo::var "y" Int))
                                          ($f_list_cons or 
                                                        a 
                                                        ($f_list_cons and b c))))))

; exists
(step $test_$prenex_normal_form_13 true 
      :rule $assert_eq 
      :args (($prenex_normal_form (exists (@varlist (eo::var "x" Int))
                                          ($f_list_cons or 
                                                        a
                                                        (exists (@varlist (eo::var "y" Int)) b))))
             (exists (@varlist (eo::var "x" Int))
                     (exists (@varlist (eo::var "y" Int))
                                          ($f_list_cons or a b)))))

(step $test_$prenex_normal_form_14 true 
      :rule $assert_eq 
      :args (($prenex_normal_form 
              (exists (@varlist (eo::var "x" Int))
                      ($f_list_cons or 
                                    a
                                    ($f_list_cons and
                                                  b
                                                  (exists (@varlist (eo::var "y" Int)) c)))))
             (exists (@varlist (eo::var "x" Int))
                     (exists (@varlist (eo::var "y" Int))
                                          ($f_list_cons or 
                                                        a 
                                                        ($f_list_cons and b c))))))

