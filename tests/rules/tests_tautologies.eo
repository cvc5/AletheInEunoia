(step $test_$ite_simplify_small_step_11 true
      :rule $assert_eq 
      :args (($ite_simplify_small_step (ite a b (ite a c d)))

             (ite a b d)))

(step $test_$ite_simplify_small_step_12 true
      :rule $assert_eq 
      :args (($ite_simplify_small_step (ite (or a a) b (ite (or a a) c d)))

             (ite (or a a) b d)))

; Case (ite 𝜓 ⊤ ⊥) ⇒ 𝜓
(step $test_$ite_simplify_small_step_13 true
      :rule $assert_eq 
      :args (($ite_simplify_small_step (ite a true false))

             a))

(step $test_$ite_simplify_small_step_14 true
      :rule $assert_eq 
      :args (($ite_simplify_small_step (ite (and a b c) true false))

             (and a b c)))

; Case (ite 𝜓 ⊥ ⊤) ⇒ ¬ 𝜓
(step $test_$ite_simplify_small_step_15 true
      :rule $assert_eq 
      :args (($ite_simplify_small_step (ite a false true))

             (not a)))

(step $test_$ite_simplify_small_step_16 true
      :rule $assert_eq 
      :args (($ite_simplify_small_step (ite (and a b c) false true))

             (not (and a b c))))

; Case (ite 𝜓 ⊤ 𝜑) ⇒ 𝜓 ∨ 𝜑
(step $test_$ite_simplify_small_step_17 true
      :rule $assert_eq 
      :args (($ite_simplify_small_step (ite a true b))

             (or a b)))

(step $test_$ite_simplify_small_step_18 true
      :rule $assert_eq 
      :args (($ite_simplify_small_step (ite (or a b) true (and b c)))

             (or (or a b) (and b c))))

; Case (ite  𝜓 𝜑 ⊥) ⇒ 𝜓 ∧ 𝜑
(step $test_$ite_simplify_small_step_19 true
      :rule $assert_eq 
      :args (($ite_simplify_small_step (ite a b false))

             (and a b)))

(step $test_$ite_simplify_small_step_20 true
      :rule $assert_eq 
      :args (($ite_simplify_small_step (ite (or a b) (and b c) false))

             (and (or a b) (and b c))))

; Case (ite 𝜓 ⊥ 𝜑) ⇒ not 𝜓 ∧ 𝜑
(step $test_$ite_simplify_small_step_21 true
      :rule $assert_eq 
      :args (($ite_simplify_small_step (ite a false b))

             (and (not a) b)))

(step $test_$ite_simplify_small_step_22 true
      :rule $assert_eq 
      :args (($ite_simplify_small_step (ite (or a b) false (and c d)))

             (and (not (or a b)) (and c d))))

; Case (ite 𝜓 𝜑 ⊤) ⇒ ¬𝜓 ∨ 𝜑
(step $test_$ite_simplify_small_step_22 true
      :rule $assert_eq 
      :args (($ite_simplify_small_step (ite a b true))

             (or (not a) b)))

(step $test_$ite_simplify_small_step_23 true
      :rule $assert_eq 
      :args (($ite_simplify_small_step (ite (or a b) (and c d) true))

             (or (not (or a b)) (and c d))))


