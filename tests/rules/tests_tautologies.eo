(step $test_$div_simplify_rec_7 true
      :rule $assert_eq 
      :args (($div_simplify_rec (/ a 1))

             a))

(step $test_$div_simplify_rec_8 true
      :rule $assert_eq 
      :args (($div_simplify_rec (/ c 1/1))

             c))

; Case 𝑡1 / 𝑡2 ⇒𝑡3 if 𝑡1 and 𝑡2 are constants and 𝑡3 is 𝑡1 divided by 𝑡2 according 
; to the semantics of the current theory.
(step $test_$div_simplify_rec_9 true
      :rule $assert_eq 
      :args (($div_simplify_rec (/ 13 2))

             6))

(step $test_$div_simplify_rec_10 true
      :rule $assert_eq 
      :args (($div_simplify_rec (/ 13/1 2/1))

             13/2))

; Misc. 
(step $test_$div_simplify_rec_11 true
      :rule $assert_eq 
      :args (($div_simplify_rec (/ a 19))

             (/ a 19)))

(step $test_$div_simplify_rec_12 true
      :rule $assert_eq 
      :args (($div_simplify_rec (/ c 3/4))

             (/ c 3/4)))

; Testing evaluation order.
(step $test_$div_simplify_rec_13 true
      :rule $assert_eq 
      :args (($div_simplify_rec (/ (/ a a) a))

             (/ 1 a)))

(step $test_$div_simplify_rec_14 true
      :rule $assert_eq 
      :args (($div_simplify_rec (/ c (/ c c)))

             c))

(step $test_$div_simplify_rec_15 true
      :rule $assert_eq 
      :args (($div_simplify_rec (/ (/ 2/2 2/2) (/ c c)))

             1/1))

