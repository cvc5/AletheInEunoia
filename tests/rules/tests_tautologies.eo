      :rule div_simplify)

;---------------------------
; comp_simplify_small_step
;---------------------------

(declare-const a Int)
(declare-const b Int)

; Case 𝑠1 < 𝑠2 ⇒ ⊤, if 𝑠1, 𝑠2 are numerical constants and 𝑠1 is strictly less than 𝑠2
(step $test_$comp_simplify_small_step_1 true
      :rule $assert_eq 
      :args (($comp_simplify_small_step (< 1 2))

             true))

(step $test_$comp_simplify_small_step_2 true
      :rule $assert_eq 
      :args (($comp_simplify_small_step (< 1.0 2.0))

             true))

; Case 𝑠1 < 𝑠2 ⇒ ⊥, if 𝑠1, 𝑠2 are numerical constants and 𝑠1 is greater or equal than 𝑠2
(step $test_$comp_simplify_small_step_3 true
      :rule $assert_eq 
      :args (($comp_simplify_small_step (< 2 1))

             false))

(step $test_$comp_simplify_small_step_4 true
      :rule $assert_eq 
      :args (($comp_simplify_small_step (< 2.0 1.0))

             false))

; Case 𝑠1 ≤ 𝑠2 ⇒ ⊤ if 𝑠1, 𝑠2 are numerical constants and 𝑠1 is less or equal than 𝑠2.
(step $test_$comp_simplify_small_step_5 true
      :rule $assert_eq 
      :args (($comp_simplify_small_step (<= 1 2))

             true))

(step $test_$comp_simplify_small_step_6 true
      :rule $assert_eq 
      :args (($comp_simplify_small_step (<= 2.0 2.0))

             true))

; Case 𝑠1 ≤ 𝑠2 ⇒ ⊥ if 𝑠1, 𝑠2 are numerical constants and 𝑠1 is strictly greater than 𝑠2
(step $test_$comp_simplify_small_step_5 true
      :rule $assert_eq 
      :args (($comp_simplify_small_step (<= 2 1))

             false))

(step $test_$comp_simplify_small_step_6 true
      :rule $assert_eq 
      :args (($comp_simplify_small_step (<= 4.0 2.0))

             false))

; Case 𝑠 < 𝑠 ⇒ ⊥
(step $test_$comp_simplify_small_step_6 true
      :rule $assert_eq 
      :args (($comp_simplify_small_step (< 2 2))

             false))

(step $test_$comp_simplify_small_step_7 true
      :rule $assert_eq 
      :args (($comp_simplify_small_step (< 4.0 4.0))

             false))

(step $test_$comp_simplify_small_step_8 true
      :rule $assert_eq 
      :args (($comp_simplify_small_step (< a a))

             false))

; Case 𝑠 <= 𝑠 ⇒ ⊤
(step $test_$comp_simplify_small_step_9 true
      :rule $assert_eq 
      :args (($comp_simplify_small_step (<= 2 2))

             true))

(step $test_$comp_simplify_small_step_10 true
      :rule $assert_eq 
      :args (($comp_simplify_small_step (<= 4.0 4.0))

             true))

(step $test_$comp_simplify_small_step_11 true
      :rule $assert_eq 
      :args (($comp_simplify_small_step (<= a a))

             true))

; Case 𝑠1 ≥ 𝑠2 ⇒ 𝑠2 ≤ 𝑠1
(step $test_$comp_simplify_small_step_12 true
      :rule $assert_eq 
      :args (($comp_simplify_small_step (>= a b))

             (<= b a)))

(step $test_$comp_simplify_small_step_13 true
      :rule $assert_eq 
      :args (($comp_simplify_small_step (>= 1 2))

             (<= 2 1)))

; Case 𝑠1 < 𝑠2 ⇒ not (𝑠2 ≤ 𝑠1)
(step $test_$comp_simplify_small_step_14 true
      :rule $assert_eq 
      :args (($comp_simplify_small_step (< a b))

             (not (<= b a))))

; Case 𝑠1 > 𝑠2 ⇒ not (𝑠1 ≤ 𝑠2)
(step $test_$comp_simplify_small_step_14 true
      :rule $assert_eq 
      :args (($comp_simplify_small_step (> a b))

             (not (<= a b))))

