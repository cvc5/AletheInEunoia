;-------------
; and_simplify
;-------------

; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)

; First case of $and_simplify_rec
(step $test_$and_simplify_1
      (@cl (= true true))
      :rule and_simplify)

(step $test_$and_simplify_2
      (@cl (= (and true true) true))
      :rule and_simplify)

(step $test_$and_simplify_3
      (@cl (= (and true true true) true))
      :rule and_simplify)

(step $test_$and_simplify_4
      (@cl (= (and true true true true) true))
      :rule and_simplify)

; Second case of $and_simplify_rec
(step $test_$and_simplify_5
      (@cl (= (and a true) a))
      :rule and_simplify)

(step $test_$and_simplify_6
      (@cl (= (and true a) a))
      :rule and_simplify)

(step $test_$and_simplify_7
      (@cl (= (and true a true) a))
      :rule and_simplify)

(step $test_$and_simplify_8
      (@cl (= (and true true a true) a))
      :rule and_simplify)

