(declare-const a Int)
(declare-const b Int)
(declare-const c Real)
(declare-const d Real)

; Case t - t => 0
(step $test_$minus_simplify_rec_1 true
      :rule $assert_eq 
      :args (($minus_simplify_rec (- a a))

             0))

(step $test_$minus_simplify_rec_2 true
      :rule $assert_eq 
      :args (($minus_simplify_rec (- c c))

             0/1))

(step $test_$minus_simplify_rec_3 true
      :rule $assert_eq 
      :args (($minus_simplify_rec (- 3 3))

             0))

(step $test_$minus_simplify_rec_4 true
      :rule $assert_eq 
      :args (($minus_simplify_rec (- 3/1 3/1))

             0/1))

; Case 𝑡1 − 𝑡2 ⇒ 𝑡3, where 𝑡1 and 𝑡2 are numerical constants and 𝑡3 is 𝑡2 subtracted 
(step $test_$minus_simplify_rec_5 true
      :rule $assert_eq 
