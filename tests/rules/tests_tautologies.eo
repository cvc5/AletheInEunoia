      :args (($check_qnt_rm_unused 
              (@cl (= (exists (@varlist (eo::var "x" Int) (eo::var "y" Int)
                                        (eo::var "z" Int))
                              (exists (@varlist (eo::var "x" Int)) true))
                      (exists (@varlist (eo::var "y" Int))
                              (exists (@varlist (eo::var "x" Int)) true)))))

             true))

