      :rule ac_simp)

(step $test_ac_simp_19
      (@cl (= (or (or a b a) (or a b a) (or (or c d d) false)) (or a b c d)))
      :rule ac_simp)

(step $test_ac_simp_20
      (@cl (= (and (and a b a) (and (and c d d) true)) (and a b c d)))
      :rule ac_simp)

(step $test_ac_simp_21
      (@cl (= (and (and a b a) (and a b a) (and (and c d d) true)) (and a b c d)))
      :rule ac_simp)

; Nesting
(step $test_ac_simp_22
      (@cl (= (or a a (and b b)) (or a b)))
      :rule ac_simp)

(step $test_ac_simp_23
      (@cl (= (or a a (and b (and b c))) (or a (and b c))))
      :rule ac_simp)

(step $test_ac_simp_24
      (@cl (= (or (or a (or a a)) (and b (and b c))) (or a (and b c))))
      :rule ac_simp)

; Taken from a VeriT certificate
(declare-const p00 Bool)
(declare-const p01 Bool)
(declare-const p10 Bool)
(declare-const p11 Bool)

(step $test_ac_simp_25
      (@cl (= (or (or (and p00 (and (not p00) p00))
                      (and p01 (and (not p01) p01)))
                  (or (and p10 (and (not p10) p10))
                      (and p11 (and (not p11) p11))))
              (or (and (not p00) p00)
                  (and (not p01) p01)
                  (and (not p10) p10)
                  (and (not p11) p11))))
      :rule ac_simp)

; Another test from a VeriT cert
(declare-const A0 Bool)   ; (= e0 (op e0 (op e0 e0)))
(declare-const B0 Bool)   ; (= e0 (op (op e0 e0) e0))
(declare-const A1 Bool)   ; (= e1 (op e1 (op e1 e1)))
(declare-const B1 Bool)   ; (= e1 (op (op e1 e1) e1))
