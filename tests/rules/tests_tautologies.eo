;-------------
; eq_symmetric
;-------------

; Some constants to build terms, for testing purposes.
(declare-const a Int)
(declare-const b Int)
(declare-const c Real)
(declare-const d Real)
(declare-const S Type)
(declare-const e S)
(declare-const f S)
(declare-const g (-> S S))

; Arbitrary arith terms
(step $test_$eq_symmetric_1
      (@cl (= (= 1 2) (= 2 1)))
      :rule eq_symmetric)

(step $test_$eq_symmetric_2
      (@cl (= (= 1.0 2.0) (= 2.0 1.0)))
      :rule eq_symmetric)

(step $test_$eq_symmetric_3
      (@cl (= (= a b) (= b a)))
      :rule eq_symmetric)

(step $test_$eq_symmetric_4
      (@cl (= (= (+ a 1) b) (= b (+ a 1))))
      :rule eq_symmetric)

(step $test_$eq_symmetric_5
      (@cl (= (= (+ c 1) d) (= d (+ c 1))))
      :rule eq_symmetric)

; Boolean terms

(step $test_$eq_symmetric_6
      (@cl (= (= true false) (= false true)))
      :rule eq_symmetric)

(step $test_$eq_symmetric_7
      (@cl (= (= (or true true) false) (= false (or true true))))
      :rule eq_symmetric)

(step $test_$eq_symmetric_8
      (@cl (= (= (or true true) (and false true)) 
              (= (and false true) (or true true))))
      :rule eq_symmetric)

; Arbitrary sorts

(step $test_$eq_symmetric_9
      (@cl (= (= e f) (= f e)))
      :rule eq_symmetric)

(step $test_$eq_symmetric_10
      (@cl (= (= e e) (= e e)))
      :rule eq_symmetric)

(step $test_$eq_symmetric_11
      (@cl (= (= (g e) e) (= e (g e))))
      :rule eq_symmetric)

(step $test_$eq_symmetric_12
      (@cl (= (= (g e) (g (g f))) (= (g (g f)) (g e))))
      :rule eq_symmetric)

;-------------
; qnt_simplify
;-------------
; NOTE: it would be interesting to be able to check the cases where this rule should
;       not apply.
(step $test_qnt_simplify_1
      (@cl (= (forall @varlist.nil true) true))
      :rule qnt_simplify)

(step $test_qnt_simplify_2
      (@cl (= (forall @varlist.nil false) false))
      :rule qnt_simplify)

;----------
; tautology
;----------

(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(declare-const d Bool)

(assume premise_tautology_1 (@cl a (not a)))
(step $test_tautology_1
      (@cl true)
      :rule tautology
      :premises (premise_tautology_1))

(assume premise_tautology_2 (@cl a b (not a)))
(step $test_tautology_2
      (@cl true)
      :rule tautology
      :premises (premise_tautology_2))

(assume premise_tautology_3 (@cl a b c (not a)))
(step $test_tautology_tautology_3
      (@cl true)
      :rule tautology
      :premises (premise_tautology_3))

(assume premise_tautology_4 (@cl a (not b) c (not a)))
(step $test_tautology_tautology_4
      (@cl true)
      :rule tautology
      :premises (premise_tautology_4))

(assume premise_tautology_5 (@cl d (not (not a)) c (not a)))
(step $test_tautology_5
      (@cl true)
      :rule tautology
      :premises (premise_tautology_5))

(assume premise_tautology_6 (@cl d (not (not a)) c (not (not (not a)))))
(step $test_tautology_tautology_6
      (@cl true)
      :rule tautology
      :premises (premise_tautology_6))

(assume premise_tautology_7 (@cl d d (not (not (not a))) (not (not (not (not a)))) c 
                       (not (not (not a)))))
(step $test_tautology_7
      (@cl true)
      :rule tautology
      :premises (premise_tautology_7))

;---------------------------
; eq_simplify_small_step
;---------------------------

(declare-const a Int)
(declare-const c Real)

; Case 𝑡 ≈ 𝑡 ⇒ ⊤
(step $test_$eq_simplify_small_step_1 true
      :rule $assert_eq 
      :args (($eq_simplify_small_step (= 13 13))

             true))

(step $test_$eq_simplify_small_step_2 true
      :rule $assert_eq 
      :args (($eq_simplify_small_step (= 13/2 13/2))

             true))

(step $test_$eq_simplify_small_step_3 true
      :rule $assert_eq 
      :args (($eq_simplify_small_step (= a a))

             true))

(step $test_$eq_simplify_small_step_4 true
      :rule $assert_eq 
      :args (($eq_simplify_small_step (= b b))

             true))

; Case (𝑡1 ≈ 𝑡2) ⇒ ⊥if 𝑡1 and 𝑡2 are different numeric constants
(step $test_$eq_simplify_small_step_5 true
      :rule $assert_eq 
      :args (($eq_simplify_small_step (= 1 2))

             false))

(step $test_$eq_simplify_small_step_6 true
      :rule $assert_eq 
      :args (($eq_simplify_small_step (= 1/1 2/1))

             false))

(step $test_$eq_simplify_small_step_7 true
      :rule $assert_eq 
      :args (($eq_simplify_small_step (= 1 a))

             (= 1 a)))

(step $test_$eq_simplify_small_step_8 true
      :rule $assert_eq 
      :args (($eq_simplify_small_step (= b 1/1))

             (= b 1/1)))

; Case ¬(𝑡 ≈ 𝑡) ⇒ ⊥ if 𝑡 is a numeric constant.
(step $test_$eq_simplify_small_step_9 true
      :rule $assert_eq 
      :args (($eq_simplify_small_step (not (= 1 1)))

             false))

(step $test_$eq_simplify_small_step_10 true
      :rule $assert_eq 
      :args (($eq_simplify_small_step (not (= 1/1 1/1)))

             false))

(step $test_$eq_simplify_small_step_11 true
      :rule $assert_eq 
      :args (($eq_simplify_small_step (not (= 1/1 b)))

             (not (= 1/1 b))))

(step $test_$eq_simplify_small_step_12 true
      :rule $assert_eq 
      :args (($eq_simplify_small_step (not (= a 1)))

             (not (= a 1))))

;---------------------------
; eq_simplify
;---------------------------

(declare-const a Int)
(declare-const b Real)

; Case 𝑡 ≈ 𝑡 ⇒ ⊤
(step $test_$eq_simplify_small_step_1 
      (@cl (= (= 13 13) true))
      :rule eq_simplify)

(step $test_$eq_simplify_small_step_2 
      (@cl (= (= 13/2 13/2) true))
      :rule eq_simplify)

(step $test_$eq_simplify_small_step_3 
      (@cl (= (= a a) true))
      :rule eq_simplify)

(step $test_$eq_simplify_small_step_4 
      (@cl (= (= b b) true))
      :rule eq_simplify)

; Case (𝑡1 ≈ 𝑡2) ⇒ ⊥if 𝑡1 and 𝑡2 are different numeric constants
(step $test_$eq_simplify_small_step_5 
      (@cl (= (= 1 2) false))
      :rule eq_simplify)

(step $test_$eq_simplify_small_step_6
      (@cl (= (= 1/1 2/1) false))
      :rule eq_simplify)

(step $test_$eq_simplify_small_step_7 
      (@cl (= (= 1 a) (= 1 a)))
      :rule eq_simplify)

(step $test_$eq_simplify_small_step_8 
      (@cl (= (= b 1/1) (= b 1/1)))
      :rule eq_simplify)

; Case ¬(𝑡 ≈ 𝑡) ⇒ ⊥ if 𝑡 is a numeric constant.
(step $test_$eq_simplify_small_step_9 
      (@cl (= (not (= 1 1)) false))
      :rule eq_simplify)

(step $test_$eq_simplify_small_step_10 
      (@cl (= (not (= 1/1 1/1)) false))
      :rule eq_simplify)

(step $test_$eq_simplify_small_step_11 
      (@cl (= (not (= 1/1 b)) (not (= 1/1 b))))
      :rule eq_simplify)

(step $test_$eq_simplify_small_step_12 
      (@cl (= (not (= a 1)) (not (= a 1))))
      :rule eq_simplify)

;---------------------------
; div_simplify_small_step
;--------------------------

(declare-const a Int)
(declare-const c Real)

; Case 𝑡 / 𝑡 ⇒ 1
(step $test_$div_simplify_small_step_1 true
      :rule $assert_eq 
      :args (($div_simplify_small_step (/ 13 13))

             1))

(step $test_$div_simplify_small_step_2 true
      :rule $assert_eq 
      :args (($div_simplify_small_step (/ 13/1 13/1))

             1/1))

(step $test_$div_simplify_small_step_3 true
      :rule $assert_eq 
      :args (($div_simplify_small_step (/ a a))

             1))

(step $test_$div_simplify_small_step_4 true
      :rule $assert_eq 
      :args (($div_simplify_small_step (/ c c))

             1/1))

; Case 𝑡 / 1 ⇒ t
(step $test_$div_simplify_small_step_5 true
      :rule $assert_eq 
      :args (($div_simplify_small_step (/ 13 1))

             13))

(step $test_$div_simplify_small_step_6 true
      :rule $assert_eq 
      :args (($div_simplify_small_step (/ 13/1 1/1))

             13/1))

(step $test_$div_simplify_small_step_7 true
      :rule $assert_eq 
      :args (($div_simplify_small_step (/ a 1))

             a))

(step $test_$div_simplify_small_step_8 true
      :rule $assert_eq 
      :args (($div_simplify_small_step (/ c 1/1))

             c))

; Case 𝑡1 / 𝑡2 ⇒𝑡3 if 𝑡1 and 𝑡2 are constants and 𝑡3 is 𝑡1 divided by 𝑡2 according 
; to the semantics of the current theory.
(step $test_$div_simplify_small_step_9 true
      :rule $assert_eq 
      :args (($div_simplify_small_step (/ 13 2))

             6))

(step $test_$div_simplify_small_step_10 true
      :rule $assert_eq 
      :args (($div_simplify_small_step (/ 13/1 2/1))

             13/2))

; Misc. 

(step $test_$div_simplify_small_step_11 true
      :rule $assert_eq 
      :args (($div_simplify_small_step (/ a 19))

             (/ a 19)))

(step $test_$div_simplify_small_step_12 true
      :rule $assert_eq 
      :args (($div_simplify_small_step (/ c 3/4))

             (/ c 3/4)))

