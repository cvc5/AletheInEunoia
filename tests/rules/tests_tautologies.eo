      :rule $assert_eq 
      :args (($bool_simplify_small_step (not ($f_list_cons or a ($f_list_cons or b ($f_list_cons or c d)))))
             ($f_list_cons and (not a) (not ($f_list_cons or b ($f_list_cons or c d))))))

