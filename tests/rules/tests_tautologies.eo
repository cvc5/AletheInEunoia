;-------------
; eq_symmetric
;-------------

; Some constants to build terms, for testing purposes.
(declare-const a Int)
(declare-const b Int)
(declare-const c Real)
(declare-const d Real)
(declare-const S Type)
(declare-const e S)
(declare-const f S)
(declare-const g (-> S S))

; Arbitrary arith terms
(step $test_$eq_symmetric_1
      (@cl (= (= 1 2) (= 2 1)))
      :rule eq_symmetric)

(step $test_$eq_symmetric_2
      (@cl (= (= 1.0 2.0) (= 2.0 1.0)))
      :rule eq_symmetric)

(step $test_$eq_symmetric_3
      (@cl (= (= a b) (= b a)))
      :rule eq_symmetric)

(step $test_$eq_symmetric_4
      (@cl (= (= (+ a 1) b) (= b (+ a 1))))
      :rule eq_symmetric)

(step $test_$eq_symmetric_5
      (@cl (= (= (+ c 1) d) (= d (+ c 1))))
      :rule eq_symmetric)

; Boolean terms

(step $test_$eq_symmetric_6
      (@cl (= (= true false) (= false true)))
      :rule eq_symmetric)

(step $test_$eq_symmetric_7
      (@cl (= (= (or true true) false) (= false (or true true))))
      :rule eq_symmetric)

(step $test_$eq_symmetric_8
      (@cl (= (= (or true true) (and false true)) 
              (= (and false true) (or true true))))
      :rule eq_symmetric)

; Arbitrary sorts

(step $test_$eq_symmetric_9
      (@cl (= (= e f) (= f e)))
      :rule eq_symmetric)

(step $test_$eq_symmetric_10
      (@cl (= (= e e) (= e e)))
      :rule eq_symmetric)

(step $test_$eq_symmetric_11
      (@cl (= (= (g e) e) (= e (g e))))
      :rule eq_symmetric)

(step $test_$eq_symmetric_12
      (@cl (= (= (g e) (g (g f))) (= (g (g f)) (g e))))
      :rule eq_symmetric)

;-------------
; qnt_simplify
;-------------
; NOTE: it would be interesting to be able to check the cases where this rule should
;       not apply.
(step $test_qnt_simplify_1
      (@cl (= (forall @varlist.nil true) true))
      :rule qnt_simplify)

(step $test_qnt_simplify_2
      (@cl (= (forall @varlist.nil false) false))
      :rule qnt_simplify)

;----------
; tautology
;----------

(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(declare-const d Bool)

(assume premise_tautology_1 (@cl a (not a)))
(step $test_tautology_1
      (@cl true)
      :rule tautology
      :premises (premise_tautology_1))

(assume premise_tautology_2 (@cl a b (not a)))
(step $test_tautology_2
      (@cl true)
      :rule tautology
      :premises (premise_tautology_2))

(assume premise_tautology_3 (@cl a b c (not a)))
(step $test_tautology_tautology_3
      (@cl true)
      :rule tautology
      :premises (premise_tautology_3))

(assume premise_tautology_4 (@cl a (not b) c (not a)))
(step $test_tautology_tautology_4
      (@cl true)
      :rule tautology
      :premises (premise_tautology_4))

(assume premise_tautology_5 (@cl d (not (not a)) c (not a)))
(step $test_tautology_5
      (@cl true)
      :rule tautology
      :premises (premise_tautology_5))

(assume premise_tautology_6 (@cl d (not (not a)) c (not (not (not a)))))
(step $test_tautology_tautology_6
      (@cl true)
      :rule tautology
      :premises (premise_tautology_6))

(assume premise_tautology_7 (@cl d d (not (not (not a))) (not (not (not (not a)))) c 
                       (not (not (not a)))))
(step $test_tautology_7
      (@cl true)
      :rule tautology
      :premises (premise_tautology_7))

