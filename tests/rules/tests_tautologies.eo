                              (exists (@varlist (eo::var "x" Int)) true))
                      (exists (@varlist (eo::var "y" Int))
                              (exists (@varlist (eo::var "x" Int)) true)))))

             true))

(step $test_$check_qnt_rm_unused_4 true 
