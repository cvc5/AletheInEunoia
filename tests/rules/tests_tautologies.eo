(include "../../signature/rules/tautologies.eo")
(include "../unit_test_services.eo")


; Unit tests for rules that introduce tautologies and their helper programs.

;------------------------------------------
; $check_eq_transitive_remaining_equalities
;------------------------------------------
; Some constants to build terms, for testing purposes.
(declare-const U Type)
(declare-const a U)
(declare-const b U)
(declare-const c U)
(declare-const d U)
(declare-const e U)

(step $test_$check_eq_transitive_remaining_equalities_1 true
      :rule $assert_eq 
      :args (($check_eq_transitive_remaining_equalities
              a d (@cl (not (= a b)) (not (= b d))))

             true))

(step $test_$check_eq_transitive_remaining_equalities_2 true
      :rule $assert_eq 
      :args (($check_eq_transitive_remaining_equalities
              a d (@cl (not (= a b)) (not (= b c)) (not (= c d))))

             true))

(step $test_$check_eq_transitive_remaining_equalities_3 true
      :rule $assert_eq 
      :args (($check_eq_transitive_remaining_equalities
              a d (@cl (not (= a b)) (not (= b c)) (not (= c d))))

             true))

(step $test_$check_eq_transitive_remaining_equalities_4 true
      :rule $assert_eq 
      :args (($check_eq_transitive_remaining_equalities
              a e (@cl (not (= a b)) (not (= b c)) (not (= c d)) (not (= d e))))

             true))

;------------------------------------------
; $check_eq_transitive_from_first_equality
;------------------------------------------
; Some constants to build terms, for testing purposes.
(declare-const U Type)
(declare-const a U)
(declare-const b U)
(declare-const c U)
(declare-const d U)
(declare-const e U)

(step $test_$check_eq_transitive_from_first_equality_1 true
      :rule $assert_eq 
      :args (($check_eq_transitive_from_first_equality
              (= a d) (@cl (not (= a b)) (not (= b d))))

             true))

(step $test_$check_eq_transitive_from_first_equality_2 true
      :rule $assert_eq 
      :args (($check_eq_transitive_from_first_equality
              (= a d) (@cl (not (= a b)) (not (= b c)) (not (= c d))))

             true))

(step $test_$check_eq_transitive_from_first_equality_3 true
      :rule $assert_eq 
      :args (($check_eq_transitive_from_first_equality
              (= a d) (@cl (not (= a b)) (not (= b c)) (not (= c d))))

             true))

(step $test_$check_eq_transitive_from_first_equality_4 true
      :rule $assert_eq 
      :args (($check_eq_transitive_from_first_equality
              (= a e) (@cl (not (= a b)) (not (= b c)) (not (= c d)) (not (= d e))))

             true))

;------------------------------------------
; $check_eq_transitive
;------------------------------------------
; Some constants to build terms, for testing purposes.
(declare-const U Type)
(declare-const a U)
(declare-const b U)
(declare-const c U)
(declare-const d U)
(declare-const e U)

(step $test_$check_eq_transitive_1 true
      :rule $assert_eq 
      :args (($check_eq_transitive
              (@cl (not (= a b)) (not (= b d)) (= a d)))

             true))

(step $test_$check_eq_transitive_2 true
      :rule $assert_eq 
      :args (($check_eq_transitive
              (@cl (not (= a b)) (not (= b c)) (not (= c d)) (= a d)))

             true))

(step $test_$check_eq_transitive_3 true
      :rule $assert_eq 
      :args (($check_eq_transitive
              (@cl (not (= a b)) (not (= b c)) (not (= c d)) (= a d)))

             true))

(step $test_$check_eq_transitive_4 true
      :rule $assert_eq 
      :args (($check_eq_transitive
              (@cl (not (= a b)) (not (= b c)) (not (= c d)) (not (= d e))
                   (= a e) ))

             true))

;------------------------------------------
; eq_transitive
;------------------------------------------
; Some constants to build terms, for testing purposes.
(declare-const U Type)
(declare-const a U)
(declare-const b U)
(declare-const c U)
(declare-const d U)
(declare-const e U)

(step $test_eq_transitive_1 
      (@cl (not (= a b)) (not (= b d)) (= a d))
      :rule eq_transitive)

(step $test_eq_transitive_2 
      (@cl (not (= a b)) (not (= b c)) (not (= c d)) (= a d))
      :rule eq_transitive)

(step $test_eq_transitive_3
      (@cl (not (= a b)) (not (= b c)) (not (= c d)) (= a d))
      :rule eq_transitive)

(step $test_eq_transitive_4
      (@cl (not (= a b)) (not (= b c)) (not (= c d)) (not (= d e))
                   (= a e))
      :rule eq_transitive)



;--------------------------------------
; $check_n_ary_application_eq_congruent
;--------------------------------------
; Some constants to build terms, for testing purposes.
(declare-const U Type)
(declare-const a U)
(declare-const b U)
(declare-const c U)
(declare-const d U)
(declare-const e U)
(declare-const j U)
(declare-const g (-> U U))
(declare-const f (-> U U U))
(declare-const h (-> U U U U))

(step $test_$check_n_ary_application_eq_congruent_1 true 
      :rule $assert_eq 
      :args (($check_n_ary_application_eq_congruent (= (g a) (g b))
                                                    (@cl (not (= a b)))) 
             true))

(step $test_$check_n_ary_application_eq_congruent_2 true 
      :rule $assert_eq 
      :args (($check_n_ary_application_eq_congruent (= (f b c) (f d e))
                                                    (@cl (not (= c e))
                                                         (not (= b d)))) 
             true))

(step $test_$check_n_ary_application_eq_congruent_3 true 
      :rule $assert_eq 
      :args (($check_n_ary_application_eq_congruent (= (h a b c) (h d e j))
              (@cl (not (= c j)) (not (= b e)) (not (= a d)))) 
             true))

;--------------------
; $check_eq_congruent
;--------------------
; Some constants to build terms, for testing purposes.
(declare-const U Type)
(declare-const a U)
(declare-const b U)
(declare-const c U)
(declare-const d U)
(declare-const e U)
(declare-const j U)
(declare-const g (-> U U))
(declare-const f (-> U U U))
(declare-const h (-> U U U U))

(step $test_$check_eq_congruent_1 true 
      :rule $assert_eq 
      :args (($check_eq_congruent 
              (@cl (not (= a b))  (= (g a) (g b)))) true))

(step $test_$check_eq_congruent_2 true 
      :rule $assert_eq 
      :args (($check_eq_congruent (@cl (not (= b d)) (not (= c e)) (= (f b c) (f d e)))) 
             true))

(step $test_$check_eq_congruent_3 true 
      :rule $assert_eq 
      :args (($check_eq_congruent (@cl (not (= a d)) (not (= b e)) (not (= c j)) 
                                       (= (h a b c) (h d e j)))) 
             true))

;--------------------
; $check_eq_congruent_pred
;--------------------
; Some constants to build terms, for testing purposes.
(declare-const U Type)
(declare-const a U)
(declare-const b U)
(declare-const c U)
(declare-const d U)
(declare-const e U)
(declare-const j U)
(declare-const g (-> U U))
(declare-const f (-> U U Bool))
(declare-const h (-> U U U Bool))

(step $test_$check_eq_congruent_pred_1 true 
      :rule $assert_eq 
      :args (($check_eq_congruent_pred 
              (@cl (not (= a b)) (not (g a)) (g b))) 

             true))

(step $test_$check_eq_congruent_pred_2 true 
      :rule $assert_eq 
      :args (($check_eq_congruent_pred (@cl (not (= b d)) (not (= c e)) 
                                            (not (f b c)) (f d e)))
             
             true))

(step $test_$check_eq_congruent_pred_3 true 
      :rule $assert_eq 
      :args (($check_eq_congruent_pred (@cl (not (= a d)) (not (= b e)) (not (= c j))
                                       (not (h a b c)) (h d e j)))

             true))

;---------
; xor_pos1
;---------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)

(step $test_xor_pos1_1
      (@cl (not (xor a b)) a b)
      :rule xor_pos1)

(step $test_xor_pos1_2
      (@cl (not (xor (or a true) b)) (or a true) b)
      :rule xor_pos1)

(step $test_xor_pos1_3
      (@cl (not (xor (or a true) (and b false))) (or a true) (and b false))
      :rule xor_pos1)

(step $test_xor_pos1_4
      (@cl (not (xor (xor a true) (and b false))) (xor a true) (and b false))
      :rule xor_pos1)

;---------
; xor_pos2
;---------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)

(step $test_xor_pos2_1
      (@cl (not (xor a b)) (not a) (not b))
      :rule xor_pos2)

(step $test_xor_pos2_2
      (@cl (not (xor (or a true) b)) (not (or a true)) (not b))
      :rule xor_pos2)

(step $test_xor_pos2_3
      (@cl (not (xor (or a true) (and b false))) (not (or a true)) (not (and b false)))
      :rule xor_pos2)

(step $test_xor_pos2_4
      (@cl (not (xor (xor a true) (and b false))) (not (xor a true)) (not (and b false)))
      :rule xor_pos2)

;---------
; xor_neg1
;---------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)

(step $test_xor_neg1_1
      (@cl (xor a b) a (not b))
      :rule xor_neg1)

(step $test_xor_neg1_2
      (@cl (xor (or a true) b) (or a true) (not b))
      :rule xor_neg1)

(step $test_xor_neg1_3
      (@cl (xor (or a true) (and b false)) (or a true) (not (and b false)))
      :rule xor_neg1)

(step $test_xor_neg1_4
      (@cl (xor (xor a true) (and b false)) (xor a true) (not (and b false)))
      :rule xor_neg1)

;---------
; xor_neg2
;---------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)

(step $test_xor_neg2_1
      (@cl (xor a b) (not a) b)
      :rule xor_neg2)

(step $test_xor_neg2_2
      (@cl (xor (or a true) b) (not (or a true)) b)
      :rule xor_neg2)

(step $test_xor_neg2_3
      (@cl (xor (or a true) (and b false)) (not (or a true)) (and b false))
      :rule xor_neg2)

(step $test_xor_neg2_4
      (@cl (xor (xor a true) (and b false)) (not (xor a true)) (and b false))
      :rule xor_neg2)

;---------
; equiv_neg1
;---------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)

(step $test_equiv_neg1_1
      (@cl (= a b) (not a) (not b))
      :rule equiv_neg1)

(step $test_equiv_neg1_2
      (@cl (= (or a true) b) (not (or a true)) (not b))
      :rule equiv_neg1)

(step $test_equiv_neg1_3
      (@cl (= (or a true) (and b false)) (not (or a true)) (not (and b false)))
      :rule equiv_neg1)

(step $test_equiv_neg1_4
      (@cl (= (xor a true) (and b false)) (not (xor a true)) (not (and b false)))
      :rule equiv_neg1)

;------------
; equiv_neg2
;------------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)

(step $test_equiv_neg2_1
      (@cl (= a b) a b)
      :rule equiv_neg2)

(step $test_equiv_neg2_2
      (@cl (= (or a true) b) (or a true) b)
      :rule equiv_neg2)

(step $test_equiv_neg2_3
      (@cl (= (or a true) (and b false)) (or a true) (and b false))
      :rule equiv_neg2)

(step $test_equiv_neg2_4
      (@cl (= (xor a true) (and b false)) (xor a true) (and b false))
      :rule equiv_neg2)


;---------
; ite_pos1
;---------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)

(step $test_ite_pos1_1
      (@cl (not (ite a c b)) a b)
      :rule ite_pos1)

(step $test_ite_pos1_2
      (@cl (not (ite (or a true) c b)) (or a true) b)
      :rule ite_pos1)

(step $test_ite_pos1_3
      (@cl (not (ite (or a true) c (and b false))) (or a true) (and b false))
      :rule ite_pos1)

(step $test_ite_pos1_4
      (@cl (not (ite (xor a true) c (and b false))) (xor a true) (and b false))
      :rule ite_pos1)

;---------
; ite_pos2
;---------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)

(step $test_ite_pos2_1
      (@cl (not (ite a b c)) (not a) b)
      :rule ite_pos2)

(step $test_ite_pos2_2
      (@cl (not (ite (or a true) b c)) (not (or a true)) b)
      :rule ite_pos2)

(step $test_ite_pos2_3
      (@cl (not (ite (or a true) (and b false) c)) 
           (not (or a true)) 
           (and b false))
      :rule ite_pos2)

(step $test_ite_pos2_4
      (@cl (not (ite (xor a true) (and b false) c)) 
           (not (xor a true)) 
           (and b false))
      :rule ite_pos2)

;---------
; ite_neg1
;---------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)

(step $test_ite_neg1_1
      (@cl (ite a c b) a (not b))
      :rule ite_neg1)

(step $test_ite_neg1_2
      (@cl (ite (or a true) c b) (or a true) (not b))
      :rule ite_neg1)

(step $test_ite_neg1_3
      (@cl (ite (or a true) c (and b false)) (or a true) (not (and b false)))
      :rule ite_neg1)

(step $test_ite_neg1_4
      (@cl (ite (xor a true) c (and b false)) (xor a true) (not (and b false)))
      :rule ite_neg1)

;---------
; ite_neg2
;---------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)

(step $test_ite_neg2_1
      (@cl (ite a b c) (not a) (not b))
      :rule ite_neg2)

(step $test_ite_neg2_2
      (@cl (ite (or a true) b c) (not (or a true)) (not b))
      :rule ite_neg2)

(step $test_ite_neg2_3
      (@cl (ite (or a true) (and b false) c) (not (or a true)) (not (and b false)))
      :rule ite_neg2)

(step $test_ite_neg2_4
      (@cl (ite (xor a true) (and b false) c) (not (xor a true)) (not (and b false)))
      :rule ite_neg2)

;--------------------
; $connective_def
;--------------------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)

; First case
(step $test_$connective_def_1 true 
      :rule $assert_eq 
      :args (($connective_def (xor a b)) 
             
             ($f_list_cons or 
                  ($f_list_cons and (not a) b)
                  ($f_list_cons and a (not b)))))

; Second case
(step $test_$connective_def_2 true 
      :rule $assert_eq 
      :args (($connective_def (= a b)) 
             
             ($f_list_cons and (=> a b) (=> b a))))

; Third case
(step $test_$connective_def_3 true 
      :rule $assert_eq 
      :args (($connective_def (ite a b c)) 
             
             ($f_list_cons and (=> a b) (=> (not a) c))))

; Fourth case
(step $test_$connective_def_4 true 
      :rule $assert_eq 
      :args (($connective_def (forall @varlist.nil a)) 
             
             (not (exists @varlist.nil (not a)))))

; Fifth case
(step $test_$connective_def_4 true 
      :rule $assert_eq 
      :args (($connective_def (exists @varlist.nil (not a))) 
             
             (not (forall @varlist.nil (not (not a))))))

;--------------------
; $check_connective_def
;--------------------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)

; First case
(step $test_$check_connective_def_1 true 
      :rule $assert_eq 
      :args (($check_connective_def 
              (@cl (= (xor a b)

                      ($f_list_cons or 
                                    ($f_list_cons and (not a) b)
                                    ($f_list_cons and a (not b))))))

             true))

; Second case
(step $test_$check_connective_def_2 true 
      :rule $assert_eq 
      :args (($check_connective_def (@cl (= (= a b)
                                            ($f_list_cons and (=> a b) (=> b a)))))
             
             true))

; Third case
(step $test_$check_connective_def_3 true 
      :rule $assert_eq 
      :args (($check_connective_def (@cl (= (ite a b c)
                                            ($f_list_cons and (=> a b) (=> (not a) c)))))

             true))

; Fourth case
(step $test_$check_connective_def_4 true 
      :rule $assert_eq 
      :args (($check_connective_def (@cl (= (forall @varlist.nil a)
                                            (not (exists @varlist.nil (not a))))))
             
             true))

; Fifth case
(step $test_$check_connective_def_4 true 
      :rule $assert_eq 
      :args (($check_connective_def (@cl (= (exists @varlist.nil (not a))
                                            (not (forall @varlist.nil (not (not a)))))))

             true))

;-------------
; $or_simplify_rec
;-------------
; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)

; First case of $or_simplify_rec:
; ⊥∨⋯∨⊥ ⇒ ⊥
(step $test_$or_simplify_rec_1 true 
      :rule $assert_eq 
      :args (($or_simplify_rec (or false false)) false))

(step $test_$or_simplify_rec_1 true 
      :rule $assert_eq 
      :args (($or_simplify_rec (or false a b false))
             ($f_list_cons or a b)))

; Second case of $or_simplify_rec:
; 𝜑1 ∨ ⋯ ∨ 𝜑𝑛 ⇒ 𝜑1 ∨ ⋯ ∨ 𝜑𝑛′ where the right-hand side has every repeated 
; literal removed.
(step $test_$or_simplify_rec_2 true 
      :rule $assert_eq 
      :args (($or_simplify_rec (or a a b)) 
             ($f_list_cons or a b)))

(step $test_$or_simplify_rec_3 true 
      :rule $assert_eq 
      :args (($or_simplify_rec (or a a b c c)) 
             ($f_list_cons or a ($f_list_cons or b c))))


; Third case of $or_simplify_rec:
; ⊤ ∨ ⋯ ∨ 𝜑𝑛 ⇒ ⊤
(step $test_$or_simplify_rec_4 true 
      :rule $assert_eq 
      :args (($or_simplify_rec (or a true false)) 
             true))

(step $test_$or_simplify_rec_4b true 
      :rule $assert_eq 
      :args (($or_simplify_rec (or a true b)) 
             true))

(step $test_$or_simplify_rec_4c true 
      :rule $assert_eq 
      :args (($or_simplify_rec (or a a false true b)) 
             true))

; Fourth case of $or_simplify_rec:
; 𝜑𝑖 ∨ ⋯ ∨ 𝜑𝑗 ∨ ⋯ ∨ 𝜑𝑛 ⇒ ⊤ and 𝜑𝑖 , 𝜑𝑗 are such that one is the
; negation of the other formula
(step $test_$or_simplify_rec_5 true 
      :rule $assert_eq 
      :args (($or_simplify_rec (or a (not a)))
             true))

(step $test_$or_simplify_rec_6 true 
      :rule $assert_eq 
      :args (($or_simplify_rec (or a b false b (not a)))
             true))

(step $test_$or_simplify_rec_7 true 
      :rule $assert_eq 
      :args (($or_simplify_rec (or a b false b (not b)))
             true))


;-------------
; or_simplify
;-------------

; Some constants to build terms, for testing purposes.
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)

; First case of or_simplify:
; ⊥∨⋯∨⊥⇒⊥
(step $test_$or_simplify_1
      (@cl (= false false))
      :rule or_simplify)

(step $test_$or_simplify_2
      (@cl (= (or false false) false))
      :rule or_simplify)

(step $test_$or_simplify_3
      (@cl (= (or false false false) false))
      :rule or_simplify)

(step $test_$or_simplify_4
      (@cl (= (or false false false false) false))
      :rule or_simplify)

; Second case of or_simplify
; 𝜑1 ∨⋯∨𝜑𝑛 ⇒ 𝜑1 ∨⋯∨ 𝜑𝑛′ where the right-hand side has all ⊥literals removed.
(step $test_$or_simplify_5
      (@cl (= (or a false) a))
      :rule or_simplify)

(step $test_$or_simplify_6
      (@cl (= (or false a) a))
      :rule or_simplify)

(step $test_$or_simplify_7
      (@cl (= (or false a false) a))
      :rule or_simplify)

(step $test_$or_simplify_8
      (@cl (= (or false false a false) a))
      :rule or_simplify)

(step $test_$or_simplify_9
      (@cl (= (or false false false a) a))
      :rule or_simplify)

(step $test_$or_simplify_10
      (@cl (= (or false a false b) 
              ($f_list_cons or a b)))
      :rule or_simplify)

(step $test_$or_simplify_11
      (@cl (= (or false a b c false) 
              ($f_list_cons or a ($f_list_cons or b c))))
      :rule or_simplify)

; Third case of or_simplify
; 𝜑1 ∨⋯∨𝜑𝑛⇒𝜑1 ∨⋯∨𝜑𝑛′ where the right-hand side has all repeated literals
; removed
(step $test_$or_simplify_12
      (@cl (= (or a a false) a))
      :rule or_simplify)

(step $test_$or_simplify_13
      (@cl (= (or a false a) a))
      :rule or_simplify)

(step $test_$or_simplify_14
      (@cl (= (or a false a false) a))
      :rule or_simplify)

(step $test_$or_simplify_15
      (@cl (= (or false a false a false) a))
      :rule or_simplify)

(step $test_$or_simplify_16
      (@cl (= (or false a a a) a))
      :rule or_simplify)

(step $test_$or_simplify_17
      (@cl (= (or false a b false a b) 
              ($f_list_cons or a b)))
      :rule or_simplify)

(step $test_$or_simplify_18
      (@cl (= (or false a b c c false a) 
              ($f_list_cons or b ($f_list_cons or c a))))
      :rule or_simplify)

; Fourth case of or_simplify
; 𝜑1 ∨⋯∨⊤∨⋯∨𝜑𝑛 ⇒⊤
(step $test_$or_simplify_19
      (@cl (= (or a true) true))
      :rule or_simplify)

(step $test_$or_simplify_20
      (@cl (= (or a true a) true))
      :rule or_simplify)

(step $test_$or_simplify_21
      (@cl (= (or a false a true) true))
      :rule or_simplify)

(step $test_$or_simplify_22
      (@cl (= (or false a true a false) true))
      :rule or_simplify)

(step $test_$or_simplify_23
      (@cl (= (or false a a true) true))
      :rule or_simplify)

(step $test_$or_simplify_24
      (@cl (= (or false a b false true b) 
              true))
      :rule or_simplify)

(step $test_$or_simplify_25
      (@cl (= (or false a b c c true a) 
              true))
      :rule or_simplify)

; Fifth case of or_simplify:
; - 𝜑𝑖 ∨ ⋯ ∨ 𝜑𝑗 ∨ ⋯ ∨ 𝜑𝑛 ⇒ ⊤ and 𝜑𝑖 , 𝜑𝑗 are such that one is the
;   negation of the other formula
(step $test_$or_simplify_26
      (@cl (= (or (not a) a) 
              true))
      :rule or_simplify)

(step $test_$or_simplify_27
      (@cl (= (or a (not a)) 
              true))
      :rule or_simplify)

(step $test_$or_simplify_28
      (@cl (= (or a (not (not (not a))))
              true))
      :rule or_simplify)

(step $test_$or_simplify_29
      (@cl (= (or (not (not a)) (not (not (not a))))
              true))
      :rule or_simplify)

(step $test_$or_simplify_30
      (@cl (= (or (not (not a)) false (not (not (not a))))
              true))
      :rule or_simplify)

(step $test_$or_simplify_31
      (@cl (= (or (not (not (not (not a)))) false (not (not (not a))))
              true))
      :rule or_simplify)

(step $test_$or_simplify_32
      (@cl (= (or (not (not (not (not a)))) false (not (not (not a))) b)
              true))
      :rule or_simplify)

;-------------
; not_simplify
;-------------

; Some constants to build terms, for testing purposes.
(declare-const a Bool)

; Removing leading double negations
(step $test_$not_simplify_1
      (@cl (= (not (not true)) true))
      :rule not_simplify)

(step $test_$not_simplify_2
      (@cl (= (not (not false)) false))
      :rule not_simplify)

(step $test_$not_simplify_3
      (@cl (= (not (not a)) a))
      :rule not_simplify)

(step $test_$not_simplify_4
      (@cl (= (not (not (not (not false)))) false))
      :rule not_simplify)

(step $test_$not_simplify_5
      (@cl (= (not (not (not (not (not a))))) (not a)))
      :rule not_simplify)

; Negation over constants
(step $test_$not_simplify_6
      (@cl (= (not true) false))
      :rule not_simplify)

(step $test_$not_simplify_7
      (@cl (= (not false) true))
      :rule not_simplify)

(step $test_$not_simplify_8
      (@cl (= (not (not (not (not (not false))))) true))
      :rule not_simplify)

(step $test_$not_simplify_9
      (@cl (= (not (not (not (not (not true))))) false))
      :rule not_simplify)


