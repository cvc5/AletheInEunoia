; div_simplify
;---------------------------

(declare-const a Int)
(declare-const c Real)

; Case 𝑡 / 𝑡 ⇒ 1
(step $test_div_simplify_1 
      (@cl (= (/ 13 13) 1))
      :rule div_simplify)

(step $test_div_simplify_2 
      (@cl (= (/ 13/1 13/1) 1/1))
      :rule div_simplify)

