(step $test_$check_qnt_rm_unused_1 true 
      :rule $assert_eq 
      :args (($check_qnt_rm_unused 
              (@cl (= (forall (@varlist (eo::var "x" Int) (eo::var "y" Int))
                              (forall (@varlist (eo::var "x" Int)) true))
                      (forall (@varlist (eo::var "y" Int))
                              (forall (@varlist (eo::var "x" Int)) true)))))

