(step $test_$ite_simplify_small_step_9 true
      :rule $assert_eq 
      :args (($ite_simplify_small_step (ite a (ite a b c) d))

             (ite a b d)))

(step $test_$ite_simplify_small_step_10 true
      :rule $assert_eq 
      :args (($ite_simplify_small_step (ite (or a a) (ite (or a a) b c) d))

             (ite (or a a) b d)))

