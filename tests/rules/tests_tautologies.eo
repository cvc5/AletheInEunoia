             1/1))

(step $test_$minus_simplify_rec_7 true
      :rule $assert_eq 
      :args (($minus_simplify_rec (- 3/2 3/4))

             3/4))

; Case t - 0 => t
(step $test_$minus_simplify_rec_8 true
      :rule $assert_eq 
      :args (($minus_simplify_rec (- a 0))

             a))

(step $test_$minus_simplify_rec_9 true
      :rule $assert_eq 
      :args (($minus_simplify_rec (- c 0))

             c))

(step $test_$minus_simplify_rec_10 true
      :rule $assert_eq 
      :args (($minus_simplify_rec (- 10 0))

             10))

(step $test_$minus_simplify_rec_11 true
      :rule $assert_eq 
      :args (($minus_simplify_rec (- 10/1 0/1))

             10/1))

; Case 0 - t => - t
(step $test_$minus_simplify_rec_12 true
      :rule $assert_eq 
      :args (($minus_simplify_rec (- 0 a))

             (- a)))

(step $test_$minus_simplify_rec_13 true
      :rule $assert_eq 
      :args (($minus_simplify_rec (- 0 c))

             (- c)))

(step $test_$minus_simplify_rec_14 true
      :rule $assert_eq 
      :args (($minus_simplify_rec (- 0 10))

             (- 10)))

(step $test_$minus_simplify_rec_15 true
      :rule $assert_eq 
      :args (($minus_simplify_rec (- 0/1 10/1))

             (- 10/1)))

;---------------------------
; minus_simplify
;---------------------------

(declare-const a Int)
(declare-const b Int)
(declare-const c Real)
(declare-const d Real)

; Case t - t => 0
(step $test_minus_simplify_1 
      (@cl (= (- a a) 0))
      :rule minus_simplify)

(step $test_minus_simplify_2 
      (@cl (= (- c c) 0/1))
      :rule minus_simplify)

(step $test_minus_simplify_3 
      (@cl (= (- 3 3) 0))
      :rule minus_simplify)

(step $test_minus_simplify_4 
      (@cl (= (- 3/1 3/1) 0/1))
      :rule minus_simplify)

; Case 𝑡1 − 𝑡2 ⇒ 𝑡3, where 𝑡1 and 𝑡2 are numerical constants and 𝑡3 is 𝑡2 subtracted 
(step $test_minus_simplify_5 
      (@cl (= (- 3 2) 1))
      :rule minus_simplify)

(step $test_minus_simplify_6 
      (@cl (= (- 3/1 2/1) 1/1))
      :rule minus_simplify)

(step $test_minus_simplify_7 
      (@cl (= (- 3/2 3/4) 3/4))
      :rule minus_simplify)

; Case t - 0 => t
(step $test_minus_simplify_8 
      (@cl (= (- a 0) a))
      :rule minus_simplify)

(step $test_minus_simplify_9 
      (@cl (= (- c 0) c))
      :rule minus_simplify)

(step $test_minus_simplify_10 
      (@cl (= (- 10 0) 10))
      :rule minus_simplify)

(step $test_minus_simplify_11 
      (@cl (= (- 10/1 0/1) 10/1))
      :rule minus_simplify)

; Case 0 - t => - t
(step $test_minus_simplify_12 
      (@cl (= (- 0 a) (- a)))
      :rule minus_simplify)

(step $test_minus_simplify_13 
      (@cl (= (- 0 c) (- c)))
      :rule minus_simplify)

(step $test_minus_simplify_14 
      (@cl (= (- 0 10) (- 10)))
      :rule minus_simplify)

(step $test_minus_simplify_15 
      (@cl (= (- 0/1 10/1) (- 10/1)))
      :rule minus_simplify)

;---------------------------
; unary_minus_simplify
;---------------------------

(declare-const a Int)
(declare-const c Real)

; Case (- (- t)) => t
(step $test_unary_minus_simplify_1 
      (@cl (= (- (- a)) a))
      :rule unary_minus_simplify)

(step $test_unary_minus_simplify_2
      (@cl (= (- (- 1)) 1))
      :rule unary_minus_simplify)

(step $test_unary_minus_simplify_3
      (@cl (= (- (- 3/2)) 3/2))
      :rule unary_minus_simplify)

(step $test_unary_minus_simplify_4
      (@cl (= (- (- (+ a b))) (+ a b)))
      :rule unary_minus_simplify)

; Case (- t) => u, for numerical constant t, u, such that u is negative t.
(step $test_unary_minus_simplify_5
      (@cl (= (- 1) -1))
      :rule unary_minus_simplify)

(step $test_unary_minus_simplify_6
      (@cl (= (- 2/3) -2/3))
      :rule unary_minus_simplify)

(step $test_unary_minus_simplify_7
      (@cl (= (- 0/1) -0/1))
      :rule unary_minus_simplify)

(step $test_unary_minus_simplify_8
      (@cl (= (- 0) -0))
      :rule unary_minus_simplify)


;---------------------------
; sum_simplify
;---------------------------

(declare-const a Int)
(declare-const b Int)
(declare-const c Real)
(declare-const d Real)


; Case  𝑡1 + ⋯ + 𝑡𝑛 ⇒ 𝑐 where all 𝑡𝑖 are constants and 𝑐 is their sum
(step $test_sum_simplify_1 
      (@cl (= (+ 1/1 2/1) 3/1))
      :rule sum_simplify)

(step $test_sum_simplify_2
      (@cl (= (+ 1/1 2/1 3/1 4/1) 10/1))
      :rule sum_simplify)

(step $test_sum_simplify_3
      (@cl (= (+ 1/1 2/1 3/1 4/1 5/1 6/1) 21/1))
      :rule sum_simplify)

; Case 𝑡1 + ⋯ + 𝑡𝑛 ⇒ 𝑐 + 𝑡𝑘1 + ⋯ + 𝑡𝑘𝑛 where 𝑐 is the sum of the constants of 
; 𝑡1, … , 𝑡𝑛 and 𝑡𝑘1, … , 𝑡𝑘𝑛 is 𝑡1, … , 𝑡𝑛 with the constants removed
(step $test_sum_simplify_4
      (@cl (= (+ 1/1 2/1 c) ($f_list_cons + 3/1 c)))
      :rule sum_simplify)

(step $test_sum_simplify_5
      (@cl (= (+ 1/1 2/1 c 3/1) ($f_list_cons + 6/1 c)))
      :rule sum_simplify)

(step $test_sum_simplify_6
      (@cl (= (+ 1/1 2/1 c 3/1 b) ($f_list_cons + 6/1 ($f_list_cons + b c))))
      :rule sum_simplify)

; Case  𝑡1 + ⋯ + 𝑡𝑛 ⇒ 𝑡𝑘1 + ⋯ + 𝑡𝑘𝑛: same as the previous case if c is 0
(step $test_sum_simplify_7
      (@cl (= (+ 1 -1 a) a))
      :rule sum_simplify)

(step $test_sum_simplify_8
      (@cl (= (+ 1/1 -1/1 c) c))
      :rule sum_simplify)

(step $test_sum_simplify_9
      (@cl (= (+ 1/1 -1/1 2/1 -2/1 c) c))
      :rule sum_simplify)

(step $test_sum_simplify_10
      (@cl (= (+ 1/1 -1/1 d 2/1 -2/1 c) ($f_list_cons + c d)))
      :rule sum_simplify)
