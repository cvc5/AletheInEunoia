;----------------
; $let_get_values
;----------------

(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)

(step $test_$let_get_values_1 true 
      :rule $assert_eq 
      :args (($let_get_values (_ (@let ((x Bool)) x) a))

             (@varlist a)))

(step $test_$let_get_values_2 true 
      :rule $assert_eq 
      :args (($let_get_values (_ (_ (@let ((x1 Bool) (x2 Bool)) x2) a) b))

             (@varlist a b)))

(step $test_$let_get_values_3 true 
      :rule $assert_eq 
      :args (($let_get_values (_ (_ (_ (@let ((x1 Bool) (x2 Bool) (x3 Bool)) x2) a) b) c))

             (@varlist a b c)))

(step $test_$let_get_values_4 true 
      :rule $assert_eq 
      :args (($let_get_values (_ (_ (_ (@let ((x1 Bool) (x2 Bool) (x3 Bool)) x2) a) b) c))

             (@varlist a b c)))

;----------------
; $let_get_body
;----------------

(declare-const a Bool)


(step $test_$let_get_body_1 true 
      :rule $assert_eq 
      :args (($let_get_body (_ (@let ((x Bool)) x) a))

             (eo::var "x" Bool)))

(step $test_$let_get_body_2 true 
      :rule $assert_eq 
      :args (($let_get_body (_ (_ (@let ((x1 Bool) (x2 Bool)) x2) a) b))

             (eo::var "x2" Bool)))

(step $test_$let_get_body_3 true 
      :rule $assert_eq 
      :args (($let_get_body (_ (_ (_ (@let ((x1 Bool) (x2 Bool) (x3 Bool)) x2) a) b) c))

             (eo::var "x2" Bool)))

;---------------------------
; Contexts and substitutions
;---------------------------

;-----------------------
; $context_get_variables
;-----------------------

(step $test_$context_get_variables_1 true 
      :rule $assert_eq 
      :args (($context_get_variables (@ctx @varlist.nil true))

             @varlist.nil))

(step $test_$context_get_variables_2 true 
      :rule $assert_eq 
      :args (($context_get_variables (@ctx ( ( x Bool ) ) (and (= (@var ( ( x Bool ) ) x) true))))

             (@varlist (eo::var "x" Bool))))

(step $test_$context_get_variables_3 true 
      :rule $assert_eq 
      :args (($context_get_variables (@ctx ( ( x Bool ) ( y Int ) ) 
                                           (and (= (@var ( ( x Bool ) ) x) true)
                                                (= (@var ( ( y Int ) ) y) 19))))

             (@varlist (eo::var "x" Bool) (eo::var "y" Int))))

(step $test_$context_get_variables_4 true 
      :rule $assert_eq 
      :args (($context_get_variables (@ctx ( ( x Bool ) ( y Int ) ( z @VarList )) 
                                           (and (= (@var ( ( x Bool ) ) x) true)
                                                (= (@var ( ( y Int ) ) y) 19)
                                                (= (@var ( ( z @VarList ) ) z) @varlist.nil))))

             (@varlist (eo::var "x" Bool) (eo::var "y" Int) (eo::var "z" @VarList))))

(step $test_$context_get_variables_5 true 
      :rule $assert_eq 
      :args (($context_get_variables (@ctx ( ( x Bool ) ( y Int ) ( z @VarList ) (u @Substitution)) 
                                           (and (= (@var ( ( x Bool ) ) x) true)
                                                (= (@var ( ( y Int ) ) y) 19)
                                                (= (@var ( ( z @VarList ) ) z) @varlist.nil)
                                                (= (@var ( ( u @Substitution ) ) u) @substitution.nil))))

             (@varlist (eo::var "x" Bool) (eo::var "y" Int) 
                       (eo::var "z" @VarList) (eo::var "u" @Substitution))))

