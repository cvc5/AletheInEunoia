; Another Verit example.
(declare-const U Type)
(declare-const p10 (-> U U Bool))
(declare-const p9 (-> U Bool))
(declare-const f16 (-> U U U U))
(declare-const p3 (-> U Bool))
(declare-const f2 (-> U U U))
(declare-const p4 (-> U Bool))
(declare-const f7 (-> U U))
(declare-const p1 (-> U U Bool))
(declare-const f12 (-> U U))
(declare-const c18 U)
(declare-const p14 (-> U U U Bool))
(declare-const f17 (-> U U U U))
(declare-const f13 (-> U U U U))
(declare-const f6 (-> U U))
(declare-const f5 (-> U U))
(declare-const f11 (-> U U))
(declare-const p15 (-> U U Bool))
(declare-const c8 U)
(declare-const c_0 U)
(declare-const c_1 U)

(step $test_$normalize_formula_modulo_commutativity_17 true
      :rule $assert_eq
      :args (($normalize_formula_modulo_commutativity
               (or (not (= (f5 c_0) (f5 c_0)))
                   (not (= (f5 c_1) (f5 c_1)))))
              ($normalize_formula_modulo_commutativity
               (or (not (= (f5 c_1) (f5 c_1)))
                   (not (= (f5 c_0) (f5 c_0)))))))

(step $test_$normalize_formula_modulo_commutativity_17b true
      :rule $assert_eq
      :args (($normalize_formula_modulo_commutativity
               (or (not (= c_0 (f16 c_0 c_0 c_0)))
                   (not (p10 c_0 c_0))))
              ($normalize_formula_modulo_commutativity
               (or (not (p10 c_0 c_0))
                   (not (= c_0 (f16 c_0 c_0 c_0)))))))

(step $test_$normalize_formula_modulo_commutativity_17c true
      :rule $assert_eq
      :args (($normalize_formula_modulo_commutativity
               (or (not (p10 c_0 c_0)) 
                   (not (p9 c_0)) 
                   (not (= c_0 (f16 c_0 c_0 c_0))) 
                   (= c_0 c_0) 
                   (not (p3 c_0))))
              ($normalize_formula_modulo_commutativity
               (or (not (p10 c_0 c_0)) 
                   (not (p9 c_0)) 
                   (not (= c_0 (f16 c_0 c_0 c_0))) 
                   (= c_0 c_0) 
                   (not (p3 c_0))))))
